    <!-- Capítulo 3: Llegada al Hogar y Negocio -->
    <section class="scrolly-chapter min-h-screen flex items-center px-6 lg:px-20 max-w-7xl mx-auto" data-step="2">
      <div class="scrolly-card max-w-lg bg-white/85 backdrop-blur-md p-8 sm:p-10 rounded-3xl border border-slate-200/90 shadow-2xl space-y-4">
        <span class="text-xs font-mono font-bold uppercase text-emerald-600 tracking-widest block">
