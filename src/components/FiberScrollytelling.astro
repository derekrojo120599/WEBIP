      <div class="scrolly-card bg-white/90 backdrop-blur-md p-8 sm:p-12 rounded-3xl border border-slate-200 shadow-2xl space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-red-50 border border-red-200 text-xs text-[#FC0432] font-semibold uppercase tracking-wider font-mono">
          Toda la Región Conectada
        </div>
        <h2 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight leading-tight">
          Elige tu plan y vive <br />
          <span class="text-gradient-ip">una experiencia superior</span>
        </h2>
        <p class="text-base sm:text-lg text-slate-600 max-w-xl mx-auto leading-relaxed">
          Consulta cobertura en tu sector y contrata hoy el plan de internet más confiable del estado Trujillo.
        </p>
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="#planes" 
            class="w-full sm:w-auto px-8 py-4 rounded-xl text-base font-bold text-white bg-gradient-to-r from-[#FC0432] via-[#ff2b52] to-[#DF0E0E] hover:from-[#ff2b52] hover:to-[#FC0432] shadow-xl shadow-[#FC0432]/30 transition-all uppercase tracking-wider"
          >
            Ver Planes y Tarifas
          </a>
          <a 
            href="https://portal.ipsistemas.com.ve" 
            target="_blank" 
            class="w-full sm:w-auto px-8 py-4 rounded-xl text-base font-bold text-[#0A559F] bg-blue-50 border border-blue-200 hover:bg-[#0A559F] hover:text-white transition-all shadow-xs"
          >
            Portal de Pagos
          </a>
        </div>
      </div>
    </section>

  </div>
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import * as THREE from 'three';

  gsap.registerPlugin(ScrollTrigger);

  function setupFiberScrollytelling() {
    const canvas = document.getElementById('scrolly-canvas-3d') as HTMLCanvasElement | null;
    const wrapper = document.getElementById('fiber-scrollytelling-wrapper');
    const canvasContainer = document.getElementById('scrolly-canvas-container');

    if (!canvas || !wrapper || !canvasContainer) return;

    // --- 2. Escena Three.js ---
    const scene = new THREE.Scene();
    scene.background = new THREE.Color('#f8fafc');
    scene.fog = new THREE.FogExp2('#eef1ec', 0.018);

    // 1. Configuración de cámara inicial: FOV 40 (lente 50mm cinematográfico)
    const camera = new THREE.PerspectiveCamera(40, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.set(0, 8, 10);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: 'high-performance' });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.1;

    // 2. Luces base
    const ambientLight = new THREE.AmbientLight(0x8a9a8a, 0.4);
    scene.add(ambientLight);

    const keyLight = new THREE.DirectionalLight(0xffffff, 2.2);
    keyLight.position.set(6, 3.5, 5);
    keyLight.castShadow = true;
    keyLight.shadow.mapSize.set(2048, 2048);
    keyLight.shadow.camera.near = 0.5;
    keyLight.shadow.camera.far = 60;
    keyLight.shadow.camera.left = -16;
    keyLight.shadow.camera.right = 16;
    keyLight.shadow.camera.top = 16;
    keyLight.shadow.camera.bottom = -16;
    keyLight.shadow.bias = -0.0004;
    scene.add(keyLight);

    const rimLight = new THREE.DirectionalLight(0x38bdf8, 0.9);
    rimLight.position.set(-3, 2, -4);
    scene.add(rimLight);

    const redGlow = new THREE.PointLight(0xFC0432, 3, 20);
    redGlow.position.set(0, 4.5, 0);
    scene.add(redGlow);

    const blueGlow = new THREE.PointLight(0x0A559F, 1.4, 20);
    blueGlow.position.set(-5, 3.5, 4);
    scene.add(blueGlow);

    // Grupo Principal
    const mapGroup = new THREE.Group();
    scene.add(mapGroup);

    // Texturas Procedurales
    function createSculptedTerrainTexture(): THREE.CanvasTexture {
      const texCanvas = document.createElement('canvas');
      texCanvas.width = 2048;
      texCanvas.height = 2048;
      const ctx = texCanvas.getContext('2d');
      if (ctx) {
        ctx.fillStyle = '#f8fafc';
        ctx.fillRect(0, 0, 2048, 2048);

        const imgData = ctx.getImageData(0, 0, 2048, 2048);
        const data = imgData.data;
        for (let i = 0; i < data.length; i += 4) {
          const noise = (Math.random() - 0.5) * 14;
          data[i] = Math.min(255, Math.max(220, 248 + noise));
          data[i + 1] = Math.min(255, Math.max(225, 250 + noise));
          data[i + 2] = Math.min(255, Math.max(230, 252 + noise));
        }
        ctx.putImageData(imgData, 0, 0);
      }
      const tex = new THREE.CanvasTexture(texCanvas);
      tex.wrapS = THREE.RepeatWrapping;
      tex.wrapT = THREE.RepeatWrapping;
      return tex;
    }

    function hash(x: number, y: number) {
      let p = x * 12.9898 + y * 78.233;
      p = Math.sin(p) * 43758.5453;
      return p - Math.floor(p);
    }

    function smoothNoise(x: number, y: number) {
      const ix = Math.floor(x);
      const iy = Math.floor(y);
      const fx = x - ix;
      const fy = y - iy;

      const sx = fx * fx * (3 - 2 * fx);
      const sy = fy * fy * (3 - 2 * fy);

      const a = hash(ix, iy);
      const b = hash(ix + 1, iy);
      const c = hash(ix, iy + 1);
      const d = hash(ix + 1, iy + 1);

      return a + (b - a) * sx + (c - a) * sy + (a - b - c + d) * sx * sy;
    }

    function fbm(x: number, y: number) {
      let total = 0;
      let amplitude = 1;
      let frequency = 1;
      let maxValue = 0;

      for (let i = 0; i < 5; i++) {
        total += smoothNoise(x * frequency, y * frequency) * amplitude;
        maxValue += amplitude;
        amplitude *= 0.5;
        frequency *= 2;
      }
      return total / maxValue;
    }

    function getElevation(x: number, z: number) {
      const warpX = fbm(x * 0.2, z * 0.2);
      const warpZ = fbm(x * 0.2 + 5.2, z * 0.2 + 1.3);

      const nx = x * 0.15 + warpX * 1.5;
      const nz = z * 0.15 + warpZ * 1.5;

      const distFromCenter = Math.sqrt(x*x + z*z);
      const valleyFactor = Math.min(1, Math.max(0, (distFromCenter - 2) * 0.15));

      const rawFbm = fbm(nx, nz);
      const height = (rawFbm * 4.5 - 0.8) * valleyFactor;
      
      return Math.max(-0.5, height);
    }

    const terrainTexture = createSculptedTerrainTexture();

    // Malla de Terreno
    const terrainWidth = 24;
    const terrainDepth = 24;
    const terrainSegments = 140;
    const terrainGeo = new THREE.PlaneGeometry(terrainWidth, terrainDepth, terrainSegments, terrainSegments);
    terrainGeo.rotateX(-Math.PI / 2);

    const pos = terrainGeo.attributes.position;
    for (let i = 0; i < pos.count; i++) {
      const x = pos.getX(i);
      const z = pos.getZ(i);
      pos.setY(i, getElevation(x, z));
    }
    terrainGeo.computeVertexNormals();

    const colors = new Float32Array(pos.count * 3);
    const normals = terrainGeo.attributes.normal;
    const upVector = new THREE.Vector3(0, 1, 0);
    const vNormal = new THREE.Vector3();

    const colorValley = new THREE.Color('#6b7d5a');
    const colorMid = new THREE.Color('#8a7d5f');
    const colorSteep = new THREE.Color('#9a978f');
    const colorPeak = new THREE.Color('#e0dfd5');

    for (let i = 0; i < pos.count; i++) {
      const y = pos.getY(i);
      vNormal.fromBufferAttribute(normals, i);
      const slope = 1.0 - vNormal.dot(upVector);

      let finalColor = new THREE.Color();

      if (slope > 0.3) {
        finalColor.copy(colorSteep);
      } else {
        if (y < 0.2) {
          finalColor.copy(colorValley);
        } else if (y < 1.5) {
          finalColor.copy(colorValley).lerp(colorMid, (y - 0.2) / 1.3);
        } else {
          finalColor.copy(colorMid).lerp(colorPeak, Math.min(1, (y - 1.5) / 1.5));
        }
        
        if (slope > 0.15) {
          finalColor.lerp(colorSteep, (slope - 0.15) / 0.15);
        }
      }

      const cNoise = (Math.random() - 0.5) * 0.04;
      finalColor.r = Math.max(0, Math.min(1, finalColor.r + cNoise));
      finalColor.g = Math.max(0, Math.min(1, finalColor.g + cNoise));
      finalColor.b = Math.max(0, Math.min(1, finalColor.b + cNoise));

      colors[i * 3] = finalColor.r;
      colors[i * 3 + 1] = finalColor.g;
      colors[i * 3 + 2] = finalColor.b;
    }

    terrainGeo.setAttribute('color', new THREE.BufferAttribute(colors, 3));

    const terrainMat = new THREE.MeshStandardMaterial({
      color: 0xffffff,
      vertexColors: true,
      map: terrainTexture,
      roughness: 0.85,
      metalness: 0.05,
      bumpMap: terrainTexture,
      bumpScale: 0.02
    });
    const terrain = new THREE.Mesh(terrainGeo, terrainMat);
    terrain.receiveShadow = true;
    terrain.castShadow = true;
    mapGroup.add(terrain);

    // Pedestal
    const baseGeo = new THREE.BoxGeometry(terrainWidth + 0.8, 1.4, terrainDepth + 0.8);
    const baseMat = new THREE.MeshStandardMaterial({
      color: 0x090d1a,
      roughness: 0.2,
      metalness: 0.85
    });
    const base = new THREE.Mesh(baseGeo, baseMat);
    base.position.y = -0.9;
    base.receiveShadow = true;
    mapGroup.add(base);

    // Torres de Red
    const nodesData = [
      { name: "Valera (Central)", x: 0, z: 0, h: 2.5, color: 0xFC0432, isCenter: true },
      { name: "Jajó", x: -5.5, z: 4.2, h: 1.95, color: 0x0A559F, isCenter: false },
      { name: "La Mesa de Esnujaque", x: -4.5, z: -5.2, h: 2.05, color: 0x0A559F, isCenter: false },
      { name: "Cabimbú", x: 4.5, z: 5.2, h: 1.85, color: 0x0A559F, isCenter: false },
      { name: "Cuicas & Burbusay", x: 6.2, z: -4.2, h: 1.75, color: 0x10B981, isCenter: false }
    ];

    const towerMeshes: THREE.Group[] = [];

    nodesData.forEach((n) => {
      const tower = new THREE.Group();
      
      n.h = getElevation(n.x, n.z);
      tower.position.set(n.x, n.h, n.z);

      const metalMat = new THREE.MeshStandardMaterial({
        color: 0x2d3748,
        metalness: 0.8,
        roughness: 0.35,
        flatShading: true
      });

      const height = n.isCenter ? 3.2 : 2.4;
      const baseRadius = n.isCenter ? 0.45 : 0.35;
      const topRadius = 0.08;
      
      // 1. Trípode (patas convergentes)
      const legs = new THREE.Group();
      for (let j = 0; j < 3; j++) {
        const angle = (j * Math.PI * 2) / 3;
        const bx = Math.cos(angle) * baseRadius;
        const bz = Math.sin(angle) * baseRadius;
        const tx = Math.cos(angle) * topRadius;
        const tz = Math.sin(angle) * topRadius;
        
        const path = new THREE.LineCurve3(new THREE.Vector3(bx, 0, bz), new THREE.Vector3(tx, height, tz));
        const legGeo = new THREE.TubeGeometry(path, 1, 0.05, 6, false);
        const leg = new THREE.Mesh(legGeo, metalMat);
        leg.castShadow = true;
        leg.receiveShadow = true;
        legs.add(leg);
      }
      tower.add(legs);

      // 2. Celosía (Lattice / anillos horizontales y cruces)
      const segmentHeight = 0.4;
      const numSegments = Math.floor(height / segmentHeight);
      
      for (let s = 0; s < numSegments; s++) {
        const h0 = s * segmentHeight;
        const h1 = Math.min((s + 1) * segmentHeight, height);
        
        const r0 = baseRadius + (topRadius - baseRadius) * (h0 / height);
        const r1 = baseRadius + (topRadius - baseRadius) * (h1 / height);
        
        for (let j = 0; j < 3; j++) {
          const angle1 = (j * Math.PI * 2) / 3;
          const angle2 = ((j + 1) * Math.PI * 2) / 3;
          
          const p1 = new THREE.Vector3(Math.cos(angle1) * r0, h0, Math.sin(angle1) * r0);
          const p2 = new THREE.Vector3(Math.cos(angle2) * r1, h1, Math.sin(angle2) * r1);
          
          const bracePath = new THREE.LineCurve3(p1, p2);
          const braceGeo = new THREE.TubeGeometry(bracePath, 1, 0.025, 6, false);
          const brace = new THREE.Mesh(braceGeo, metalMat);
          brace.castShadow = true;
          tower.add(brace);
          
          const p3 = new THREE.Vector3(Math.cos(angle2) * r0, h0, Math.sin(angle2) * r0);
          const ringPath = new THREE.LineCurve3(p1, p3);
          const ringGeo = new THREE.TubeGeometry(ringPath, 1, 0.025, 6, false);
          const ringMesh = new THREE.Mesh(ringGeo, metalMat);
          ringMesh.castShadow = true;
          tower.add(ringMesh);
        }
      }

      // 3. Paneles sectoriales cerca de la punta
      const panelGeo = new THREE.BoxGeometry(0.12, 0.35, 0.02);
      for (let j = 0; j < 3; j++) {
        const angle = (j * Math.PI * 2) / 3;
        const panel = new THREE.Mesh(panelGeo, metalMat);
        panel.position.set(Math.cos(angle) * (topRadius + 0.05), height - 0.3, Math.sin(angle) * (topRadius + 0.05));
        panel.rotation.y = -angle + Math.PI/2;
        panel.castShadow = true;
        tower.add(panel);
      }

      // 4. Parabolica (Dish)
      const dishGeo = new THREE.SphereGeometry(n.isCenter ? 0.28 : 0.22, 12, 6, 0, Math.PI * 2, 0, Math.PI / 2.2);
      const dishMat = new THREE.MeshStandardMaterial({ color: 0xf1f5f9, roughness: 0.3, metalness: 0.7 });
      const dish = new THREE.Mesh(dishGeo, dishMat);
      dish.position.set(0.15, height - 0.8, 0);
      dish.rotation.z = -Math.PI / 2.5;
      tower.add(dish);

      // 5. Beacon (Baliza luminosa)
      const beaconGeo = new THREE.SphereGeometry(n.isCenter ? 0.3 : 0.16, 16, 16);
      const beaconMat = new THREE.MeshPhysicalMaterial({
        color: n.color,
        emissive: n.color,
        emissiveIntensity: 2.5,
        roughness: 0.05,
        metalness: 0.1,
        clearcoat: 1.0
      });
      const beacon = new THREE.Mesh(beaconGeo, beaconMat);
      beacon.position.y = height + 0.1;
      tower.add(beacon);

      const haloGeo = new THREE.SphereGeometry(n.isCenter ? 0.5 : 0.28, 16, 16);
      const haloMat = new THREE.MeshBasicMaterial({
        color: n.color,
        transparent: true,
        opacity: 0.2,
        blending: THREE.AdditiveBlending
      });
      const halo = new THREE.Mesh(haloGeo, haloMat);
      halo.position.y = height + 0.1;
      tower.add(halo);

      // Eliminar el pedestal/foundation negro que generaba el muro,
      // o reducirlo al mínimo si hace falta. Como se pidió quitar, no lo agregamos.
      
      mapGroup.add(tower);
      towerMeshes.push(tower);
    });

    // Vegetación opcional de escala (Bosque / Pinos low poly)
    const treeGeo = new THREE.ConeGeometry(0.12, 0.4, 4);
    treeGeo.translate(0, 0.2, 0);
    const treeMat = new THREE.MeshStandardMaterial({ color: 0x4f5e42, roughness: 0.9, flatShading: true });
    
    // Sólo si el dispositivo no es de muy baja gama
    const treeCount = 60;
    const treeMesh = new THREE.InstancedMesh(treeGeo, treeMat, treeCount);
    treeMesh.castShadow = true;
    treeMesh.receiveShadow = true;
    
    const dummy = new THREE.Object3D();
    let treesPlaced = 0;
    
    // Distribuir árboles aleatoriamente pero sólo en laderas suaves y evitar las bases de las torres
    while (treesPlaced < treeCount) {
      const tx = (Math.random() - 0.5) * 18;
      const tz = (Math.random() - 0.5) * 18;
      const distFromCenter = Math.sqrt(tx*tx + tz*tz);
      
      // Evitar la zona central directamente debajo de Valera y los bordes extremos
      if (distFromCenter < 2 || distFromCenter > 11) continue;
      
      const ty = getElevation(tx, tz);
      
      // Evitar picos y fondos absolutos
      if (ty > 1.2 || ty < 0.1) continue;
      
      // Chequear proximidad a torres para que no se superpongan
      let nearTower = false;
      for (const n of nodesData) {
        if (Math.sqrt((n.x - tx) ** 2 + (n.z - tz) ** 2) < 1.0) nearTower = true;
      }
      if (nearTower) continue;

      dummy.position.set(tx, ty, tz);
      // Variación sutil en escala y rotación
      const scale = 0.6 + Math.random() * 0.8;
      dummy.scale.set(scale, scale, scale);
      dummy.rotation.y = Math.random() * Math.PI;
      dummy.rotation.x = (Math.random() - 0.5) * 0.1;
      dummy.rotation.z = (Math.random() - 0.5) * 0.1;
      dummy.updateMatrix();
      
      treeMesh.setMatrixAt(treesPlaced, dummy.matrix);
      treesPlaced++;
    }
    mapGroup.add(treeMesh);

    // Enlaces de Fibra Óptica Láser
    // Se calcula usando las alturas dinámicas actualizadas de los nodos
    const valeraHeight = nodesData[0].isCenter ? 3.2 : 2.4;
    const valeraPos = new THREE.Vector3(0, nodesData[0].h + valeraHeight + 0.1, 0);

    for (let i = 1; i < nodesData.length; i++) {
      const towerHeight = nodesData[i].isCenter ? 3.2 : 2.4;
      const targetPos = new THREE.Vector3(nodesData[i].x, nodesData[i].h + towerHeight + 0.1, nodesData[i].z);
      const distance = valeraPos.distanceTo(targetPos);
      
      const beamGeo = new THREE.CylinderGeometry(0.035, 0.035, distance, 8);
      const beamMat = new THREE.MeshPhysicalMaterial({
        color: 0xFC0432,
        emissive: 0xFC0432,
        emissiveIntensity: 2.2,
        transparent: true,
        opacity: 0.85,
        roughness: 0.08
      });
      const beam = new THREE.Mesh(beamGeo, beamMat);
      beam.position.copy(valeraPos).lerp(targetPos, 0.5);
      beam.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), targetPos.clone().sub(valeraPos).normalize());
      mapGroup.add(beam);
    }

    // Resize Handler
    const handleResize = () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      ScrollTrigger.refresh();
    };
    window.addEventListener('resize', handleResize);

    // --- 3. Proxy de Foco & GSAP Timeline con ScrollTrigger ---
    const cameraTarget = { x: 0, y: 0, z: 0 };

    const dots = [
      document.getElementById('dot-0'),
      document.getElementById('dot-1'),
      document.getElementById('dot-2'),
      document.getElementById('dot-3')
    ];

    function updateDots(activeIdx: number) {
      dots.forEach((dot, idx) => {
        if (!dot) return;
        if (idx === activeIdx) {
          dot.className = "scrolly-dot w-3.5 h-3.5 rounded-full bg-[#FC0432] ring-4 ring-red-100 shadow-[0_0_12px_rgba(252,4,50,0.6)] transition-all duration-300";
        } else {
          dot.className = "scrolly-dot w-2 h-2 rounded-full bg-slate-300 transition-all duration-300";
        }
      });
    }

    // GSAP Context para encapsular todos los triggers y facilitar su reversión limpia
    const ctx = gsap.context(() => {
      // Timeline Scrollytelling vinculada al contenedor con scrub 1.2 y pin sobre el canvas
      const scrollyTl = gsap.timeline({
        scrollTrigger: {
          trigger: wrapper,
          start: "top top",
          end: "bottom bottom",
          scrub: 1.2,
          pin: canvasContainer,
          pinSpacing: false
        }
      });

      // Fase 2: Acercamiento macro a texturas. Tarjeta a la derecha, la torre de Jajó está a la izq.
      // Offset de x a -5 en el target para que Jajó quede centrada a la izq
      scrollyTl
        .to(camera.position, { x: -4.5, y: 6.5, z: 4.5, ease: "power1.inOut" }, "fase-2")
        .to(cameraTarget, { x: -5, y: 0.5, z: 0, ease: "power1.inOut" }, "fase-2")

      // Fase 3: Giro de perspectiva. Tarjeta a la izquierda, torre protagonista (Cabimbú / Cuicas) a la der.
      // Offset de x a 3.0 en el target para encuadrar a la derecha
        .to(camera.position, { x: 3.5, y: 5, z: 4, ease: "power1.inOut" }, "fase-3")
        .to(cameraTarget, { x: 3, y: 0.3, z: 2, ease: "power1.inOut" }, "fase-3")
        .to(keyLight.position, { x: 0, y: 8, z: 2, ease: "power1.inOut" }, "fase-3")
        .to(keyLight, { intensity: 2.8, ease: "power1.inOut" }, "fase-3")

      // Fase 4: Encuadre final equilibrado para CTA
        .to(camera.position, { x: 0, y: 13, z: 15, ease: "power2.out" }, "fase-4")
        .to(cameraTarget, { x: 0, y: 0, z: 0, ease: "power2.out" }, "fase-4")
        .to(keyLight.position, { x: 4, y: 5, z: 4, ease: "power2.out" }, "fase-4")
        .to(keyLight, { intensity: 2.2, ease: "power2.out" }, "fase-4");

      // Triggers por capítulo para encender puntos y animar tarjetas de texto
      const chapters = gsap.utils.toArray<HTMLElement>('.scrolly-chapter');
      chapters.forEach((chapter, index) => {
        const card = chapter.querySelector('.scrolly-card');

        ScrollTrigger.create({
          trigger: chapter,
          start: "top center+=100",
          end: "bottom center-=100",
          onEnter: () => {
            updateDots(index);
            if (card) gsap.to(card, { opacity: 1, y: 0, duration: 0.4 });
          },
          onEnterBack: () => {
            updateDots(index);
            if (card) gsap.to(card, { opacity: 1, y: 0, duration: 0.4 });
          },
          onLeave: () => {
            if (card && index < chapters.length - 1) gsap.to(card, { opacity: 0.25, y: -20, duration: 0.3 });
          },
          onLeaveBack: () => {
            if (card && index > 0) gsap.to(card, { opacity: 0.25, y: 20, duration: 0.3 });
          }
        });
      });
    }, wrapper);

    requestAnimationFrame(() => ScrollTrigger.refresh());
    window.addEventListener('load', () => ScrollTrigger.refresh());

    // --- 4. Ticker unificado GSAP -> Lenis + Three.js ---
    const tickerCallback = (time: number) => {
      // 2. Interpolación suave del foco en cada frame
      camera.lookAt(cameraTarget.x, cameraTarget.y, cameraTarget.z);

      // 3. Pulsación física de balizas de torres
      const t = time * 3;
      towerMeshes.forEach((tower, i) => {
        const beacon = tower.children[3] as THREE.Mesh | undefined;
        const halo = tower.children[4] as THREE.Mesh | undefined;
        if (beacon) beacon.scale.setScalar(1 + Math.sin(t * 2 + i) * 0.12);
        if (halo) halo.scale.setScalar(1 + Math.sin(t * 2 + i) * 0.2);
      });

      // 4. Render final sincronizado
      renderer.render(scene, camera);
    };

    gsap.ticker.add(tickerCallback);
    gsap.ticker.lagSmoothing(0);

    // --- 5. Limpieza Rigurosa de Recursos (Previene Memory Leaks en View Transitions) ---
    function cleanup() {
      window.removeEventListener('resize', handleResize);
      gsap.ticker.remove(tickerCallback);
      ctx.revert();

      // Liberar geometrías, materiales y texturas de Three.js
      scene.traverse((object) => {
        const mesh = object as THREE.Mesh;
        if (mesh.geometry) {
          mesh.geometry.dispose();
        }
        if (mesh.material) {
          if (Array.isArray(mesh.material)) {
            mesh.material.forEach((mat) => mat.dispose());
          } else {
            mesh.material.dispose();
          }
        }
      });

      terrainTexture.dispose();
      terrainNormal.dispose();

      renderer.dispose();
      renderer.forceContextLoss();
    }

    document.addEventListener('astro:before-swap', cleanup, { once: true });
  }

  // Inicialización diferida (Lazy Load)
  function initLazyScrollytelling() {
    const wrapper = document.getElementById('fiber-scrollytelling-wrapper');
    if (!wrapper) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          setupFiberScrollytelling();
          observer.disconnect();
        }
      });
    }, { rootMargin: '200px 0px' });

    observer.observe(wrapper);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLazyScrollytelling);
  } else {
    initLazyScrollytelling();
  }

  document.addEventListener('astro:page-load', initLazyScrollytelling);
</script>
