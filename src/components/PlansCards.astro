---
import { servicesData, type ServiceCard } from '../data/plans';

interface Props {
  services?: ServiceCard[];
}

const { services = servicesData } = Astro.props;
---

<!-- PlansCards.astro: 4 tarjetas de servicio con detalle tangible de equipamiento estilo Xfinity -->
<section id="servicios" class="py-24 bg-slate-50 border-y border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-red-50 border border-red-200 text-xs text-[#FC0432] font-semibold uppercase tracking-wider">
        Nuestros Servicios
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        Soluciones integrales de <span class="text-gradient-ip">conectividad</span>
      </h2>
      <p class="text-slate-600 text-base sm:text-lg">
        Tecnología de telecomunicaciones y equipos de última generación instalados en Trujillo.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map((item) => (
        <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between group">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="w-12 h-12 rounded-2xl bg-red-50 border border-red-200 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
                {item.iconType}
              </span>
              {item.badge && (
                <span class="text-[10px] font-mono font-bold uppercase text-[#0A559F] bg-blue-50 px-2.5 py-1 rounded-md border border-blue-200">
                  {item.badge}
                </span>
              )}
            </div>

            <div>
              <h3 class="text-xl font-black text-slate-900 group-hover:text-[#FC0432] transition-colors">
                {item.title}
              </h3>
              <span class="text-xs font-mono font-bold text-[#FC0432] block mt-0.5">
                {item.speed}
              </span>
            </div>

            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              {item.description}
            </p>

            <!-- Detalle de equipamiento / servicio tangible (Patrón Xfinity) -->
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/70 text-[11px] text-slate-600">
              <span class="font-bold text-slate-900 block mb-0.5">Equipamiento & Servicio:</span>
              <span>{item.equipmentDetail}</span>
            </div>
          </div>

          <div class="pt-6 mt-6 border-t border-slate-100 flex items-center justify-between">
            <a 
              href={item.link} 
              class="w-full py-2.5 px-4 rounded-xl text-xs font-bold text-[#0A559F] bg-blue-50 hover:bg-[#0A559F] hover:text-white transition-all text-center flex items-center justify-center gap-1.5"
            >
              <span>Ver Opciones</span>
              <span>→</span>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
