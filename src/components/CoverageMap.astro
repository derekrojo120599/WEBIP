---
import { coverageZones, type CoverageZone } from '../data/coverage';

interface Props {
  zones?: CoverageZone[];
}

const { zones = coverageZones } = Astro.props;
---

<!-- CoverageMap.astro: Zonas de cobertura reales + Mapa embebido con marcador en Trujillo -->
<section id="cobertura" class="py-24 bg-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-50 border border-blue-200 text-xs text-[#0A559F] font-semibold uppercase tracking-wider">
        Presencia Regional
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        Zonas de Cobertura en <span class="text-gradient-ip">el Estado Trujillo</span>
      </h2>
      <p class="text-slate-600 text-base sm:text-lg">
        Llevamos conectividad de alta velocidad tanto a centros urbanos como a comunidades agrícolas y rurales.
      </p>
    </div>

    <!-- Zonas Badges Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mb-12">
      {zones.map((zone) => (
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-[#FC0432]/40 hover:bg-white hover:shadow-md transition-all text-center group">
          <div class="flex items-center justify-center gap-1.5 mb-1">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="font-bold text-slate-900 text-sm group-hover:text-[#FC0432] transition-colors">{zone.name}</span>
          </div>
          <span class="text-[11px] font-mono text-slate-500 block">{zone.type}</span>
        </div>
      ))}
    </div>

    <!-- Mapa Embebido Real (Google Maps de Valera, Edo. Trujillo) -->
    <div class="rounded-3xl overflow-hidden border border-slate-200 shadow-xl bg-slate-100 relative min-h-[420px]">
      <iframe
        title="Mapa de Cobertura IP Sistemas - Valera, Trujillo"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d63133.56543160498!2d-70.64069351052243!3d9.31742499691763!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e632822a15f0131%3A0x6b29d4db7a9d0bb5!2sValera%2C%20Trujillo!5e0!3m2!1ses!2sve!4v1710000000000!5m2!1ses!2sve"
        width="100%"
        height="450"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="w-full h-[450px]"
      ></iframe>

      <!-- Overlay flotante con llamada a consultar viabilidad -->
      <div class="absolute bottom-6 left-6 right-6 sm:right-auto sm:max-w-md bg-white/95 backdrop-blur-md p-6 rounded-2xl border border-slate-200 shadow-xl space-y-3">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-[#FC0432] animate-ping"></span>
          <h4 class="font-black text-slate-900 text-sm uppercase">¿Deseas verificar tu dirección exacta?</h4>
        </div>
        <p class="text-xs text-slate-600 leading-relaxed">
          Escríbenos tus coordenadas o sector y te confirmamos disponibilidad técnica en menos de 15 minutos.
        </p>
        <a 
          href="https://wa.me/584260337589?text=Hola,%20deseo%20verificar%20la%20cobertura%20en%20mi%20zona" 
          target="_blank"
          class="inline-flex items-center gap-2 text-xs font-bold text-[#FC0432] hover:text-[#DF0E0E]"
        >
          <span>Consultar por WhatsApp</span>
          <span>→</span>
        </a>
      </div>
    </div>

  </div>
</section>
