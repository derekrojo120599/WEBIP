<!-- Header.astro: Barra superior institucional + Navbar sticky con menú móvil -->
<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 backdrop-blur-xl bg-white/95 border-b border-slate-200/80 shadow-xs">
  
  <!-- Barra superior con teléfono, correo y horario + redes sociales -->
  <div class="hidden lg:block bg-[#0C1020] border-b border-slate-800 text-xs text-slate-300 py-2 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-6">
        <span class="flex items-center gap-1.5">
          <span class="text-[#FC0432]">📍</span> Calle 13, Valera 3101, Trujillo
        </span>
        <span class="flex items-center gap-1.5">
          <span class="text-[#FC0432]">🕒</span> Lun - Sáb: 8:00 AM - 5:00 PM
        </span>
        <span class="flex items-center gap-1.5 font-medium">
          <span class="text-emerald-400">●</span> Conatel HGTS-00565
        </span>
      </div>

      <div class="flex items-center gap-6">
        <div class="flex items-center gap-3">
          <a href="tel:02712210316" class="hover:text-white transition-colors flex items-center gap-1">
            <span class="text-[#FC0432]">📞</span> 0271-2210316
          </a>
          <span class="text-slate-600">|</span>
          <a href="tel:04260337589" class="hover:text-white transition-colors">
            0426-0337589
          </a>
        </div>
        <div class="flex items-center gap-2 pl-2 border-l border-slate-800">
          <a 
            href="https://www.instagram.com/ipsistemas.ve/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-slate-400 hover:text-[#FC0432] transition-colors"
            aria-label="Instagram IP Sistemas"
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Navbar Principal Sticky -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    
    <!-- Logo Oficial IP Sistemas -->
    <a href="/" class="flex items-center group py-1">
      <img 
        src="/icons/Logo%20color.svg" 
        alt="IP Sistemas C.A. Logo" 
        class="h-16 sm:h-[4.5rem] w-auto max-h-18 object-contain transition-transform duration-300 group-hover:scale-105"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-700">
      <a href="#planes" class="hover:text-[#FC0432] transition-colors relative py-1 group">
        <span>Planes</span>
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#FC0432] transition-all duration-200 group-hover:w-full"></span>
      </a>
      <a href="#about" class="hover:text-[#FC0432] transition-colors relative py-1 group">
        <span>La Empresa</span>
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#FC0432] transition-all duration-200 group-hover:w-full"></span>
      </a>
      <a href="#servicios" class="hover:text-[#FC0432] transition-colors relative py-1 group">
        <span>Servicios</span>
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#FC0432] transition-all duration-200 group-hover:w-full"></span>
      </a>
      <a href="#cobertura" class="hover:text-[#FC0432] transition-colors relative py-1 group">
        <span>Cobertura</span>
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#FC0432] transition-all duration-200 group-hover:w-full"></span>
      </a>
      <a href="#contacto" class="hover:text-[#FC0432] transition-colors relative py-1 group">
        <span>Contacto</span>
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#FC0432] transition-all duration-200 group-hover:w-full"></span>
      </a>
    </nav>

    <!-- Action CTAs -->
    <div class="flex items-center gap-3 sm:gap-4">
      <a 
        href="https://portal.ipsistemas.com.ve" 
        target="_blank" 
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-[#0A559F] bg-blue-50 border border-blue-200/80 hover:bg-[#0A559F] hover:text-white transition-all duration-200 shadow-xs"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="14" x="2" y="5" rx="2"></rect>
          <line x1="2" x2="22" y1="10" y2="10"></line>
        </svg>
        <span>Portal de Pagos</span>
      </a>
      
      <a 
        href="https://wa.me/584260337589?text=Hola,%20deseo%20contratar%20internet%20de%20IP%20Sistemas" 
        target="_blank" 
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-[#FC0432] via-[#ff2b52] to-[#DF0E0E] hover:from-[#ff2b52] hover:to-[#FC0432] shadow-md shadow-[#FC0432]/25 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
      >
        <span>Contratar</span>
      </a>

      <!-- Botón de Menú Hamburguesa Móvil -->
      <button 
        id="mobile-menu-btn"
        class="md:hidden p-2.5 rounded-xl text-slate-700 hover:text-[#FC0432] hover:bg-slate-100 transition-colors focus:outline-hidden"
        aria-label="Abrir menú de navegación"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

  </div>

  <!-- Menú desplegable para móviles -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-slate-200 px-4 pt-2 pb-6 space-y-3 shadow-lg">
    <a href="#planes" class="block py-2 text-base font-semibold text-slate-800 hover:text-[#FC0432] border-b border-slate-100">Planes</a>
    <a href="#about" class="block py-2 text-base font-semibold text-slate-800 hover:text-[#FC0432] border-b border-slate-100">La Empresa</a>
    <a href="#servicios" class="block py-2 text-base font-semibold text-slate-800 hover:text-[#FC0432] border-b border-slate-100">Servicios</a>
    <a href="#cobertura" class="block py-2 text-base font-semibold text-slate-800 hover:text-[#FC0432] border-b border-slate-100">Cobertura</a>
    <a href="#faq" class="block py-2 text-base font-semibold text-slate-800 hover:text-[#FC0432] border-b border-slate-100">Preguntas Frecuentes</a>
    <a href="#contacto" class="block py-2 text-base font-semibold text-slate-800 hover:text-[#FC0432] border-b border-slate-100">Contacto</a>
    
    <div class="pt-3 space-y-2">
      <a 
        href="https://portal.ipsistemas.com.ve" 
        target="_blank" 
        class="block w-full text-center py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-[#0A559F] bg-blue-50 border border-blue-200"
      >
        Portal de Pagos
      </a>
      <a 
        href="https://wa.me/584260337589?text=Hola,%20deseo%20contratar%20internet%20de%20IP%20Sistemas" 
        target="_blank" 
        class="block w-full text-center py-2.5 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-[#FC0432] to-[#DF0E0E]"
      >
        Contratar Ahora
      </a>
    </div>
  </div>

  <!-- Scroll Progress Line en border-bottom -->
  <div class="absolute bottom-0 left-0 h-[2.5px] w-full bg-slate-100 overflow-hidden pointer-events-none">
    <div 
      id="navbar-scroll-progress" 
      class="h-full w-0 bg-gradient-to-r from-[#FC0432] via-[#ff2b52] to-[#0A559F] shadow-[0_0_8px_rgba(252,4,50,0.6)] transition-[width] duration-75 ease-out"
    ></div>
  </div>
</header>

<script>
  // Control del menú móvil
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  }

  // Barra de progreso de scroll en el borde inferior
  const progressBar = document.getElementById('navbar-scroll-progress');
  function updateNavbarProgress() {
    if (!progressBar) return;
    const scrollTop = window.scrollY || document.documentElement.scrollTop;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const scrollPercent = (scrollTop / (docHeight || 1)) * 100;
    progressBar.style.width = `${Math.min(100, Math.max(0, scrollPercent))}%`;
  }

  window.addEventListener('scroll', updateNavbarProgress, { passive: true });
  window.addEventListener('resize', updateNavbarProgress);
  updateNavbarProgress();
</script>
