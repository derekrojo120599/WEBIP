<!-- TrustBar.astro: Franja oscura institucional con habilitaciones y marcas asociadas -->
<section class="py-12 bg-[#0C1020] border-y border-slate-800 text-white relative z-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8">
      
      <div class="text-center md:text-left max-w-xs">
        <span class="text-xs font-mono font-bold uppercase tracking-widest text-[#FC0432] block">
          Infraestructura Segura
        </span>
        <h3 class="text-base font-bold text-slate-200 mt-1">
          Habilitada por CONATEL y respaldada por marcas líderes
        </h3>
      </div>

      <!-- Marcas y estándares en escala de grises con hover sutil -->
      <div class="flex flex-wrap items-center justify-center md:justify-end gap-8 sm:gap-12 opacity-75 grayscale hover:grayscale-0 transition-all duration-300">
        
        <div class="flex items-center gap-2 font-mono font-bold text-sm tracking-wider text-slate-300">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
          CONATEL HGTS-00565
        </div>

        <div class="flex items-center gap-2 font-mono font-bold text-sm tracking-wider text-slate-300">
          <span class="text-[#FC0432]">●</span> FTTH GIGABIT
        </div>

        <div class="flex items-center gap-2 font-mono font-bold text-sm tracking-wider text-slate-300">
          <span class="text-[#0A559F]">●</span> MIKROTIK ROUTEROS
        </div>

        <div class="flex items-center gap-2 font-mono font-bold text-sm tracking-wider text-slate-300">
          <span class="text-amber-400">●</span> UBIQUITI NETWORKS
        </div>

      </div>

    </div>
  </div>
</section>
