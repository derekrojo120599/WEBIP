---
---

<section id="tecnologia" class="py-24 relative bg-white overflow-hidden border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Title -->
    <div class="text-center max-w-3xl mx-auto mb-20 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-50 border border-blue-200 text-xs text-[#0A559F] font-semibold uppercase tracking-wider">
        Tecnología de Punta
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        Del Nodo Central a tu <span class="text-gradient-ip">Hogar o Empresa</span>
      </h2>
      <p class="text-slate-600 text-base sm:text-lg">
        Desplázate hacia abajo para ver cómo viaja nuestra señal de fibra óptica pura con latencia casi nula.
      </p>
    </div>

    <!-- Step-by-Step Interactive Scroll Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start relative">
      
      <!-- Left: Step cards that trigger transitions on scroll -->
      <div class="lg:col-span-6 space-y-24">
        
        <!-- Step 1 -->
        <div id="tech-step-1" class="tech-step p-8 rounded-3xl bg-slate-50 border-2 border-slate-200 transition-all duration-500">
          <div class="flex items-center gap-3 mb-4">
            <span class="w-8 h-8 rounded-full bg-[#FC0432] text-white flex items-center justify-center font-black text-sm font-mono shadow-xs">
              01
            </span>
            <span class="text-xs font-mono font-bold uppercase text-[#FC0432] tracking-wider">Troncal de Alta Capacidad</span>
          </div>
          <h3 class="text-2xl font-black text-slate-900 mb-2">Nodo Central Valera</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Conexión directa a los anillos troncales internacionales de internet. Garantizamos ancho de banda continuo y redundancia total ante cualquier eventualidad.
          </p>
          <div class="mt-4 inline-flex items-center gap-2 text-xs font-mono text-emerald-700 bg-emerald-50 px-3 py-1 rounded-lg font-semibold border border-emerald-200">
            <span>●</span> Disponibilidad: 99.98% SLA
          </div>
        </div>

        <!-- Step 2 -->
        <div id="tech-step-2" class="tech-step p-8 rounded-3xl bg-slate-50 border-2 border-slate-200 opacity-60 transition-all duration-500">
          <div class="flex items-center gap-3 mb-4">
            <span class="w-8 h-8 rounded-full bg-[#0A559F] text-white flex items-center justify-center font-black text-sm font-mono shadow-xs">
              02
            </span>
            <span class="text-xs font-mono font-bold uppercase text-[#0A559F] tracking-wider">Distribución FTTH</span>
          </div>
          <h3 class="text-2xl font-black text-slate-900 mb-2">Fibra Óptica Pura</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Sin cables coaxiales ni intermediarios que degraden la velocidad. El hilo de vidrio viaja directamente por los postes hasta la puerta de tu inmueble.
          </p>
          <div class="mt-4 inline-flex items-center gap-2 text-xs font-mono text-[#0A559F] bg-blue-50 px-3 py-1 rounded-lg font-semibold border border-blue-200">
            <span>●</span> Pérdida de señal: &lt; 0.2 dB/km
          </div>
        </div>

        <!-- Step 3 -->
        <div id="tech-step-3" class="tech-step p-8 rounded-3xl bg-slate-50 border-2 border-slate-200 opacity-60 transition-all duration-500">
          <div class="flex items-center gap-3 mb-4">
            <span class="w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center font-black text-sm font-mono shadow-xs">
              03
            </span>
            <span class="text-xs font-mono font-bold uppercase text-emerald-700 tracking-wider">Terminal de Usuario</span>
          </div>
          <h3 class="text-2xl font-black text-slate-900 mb-2">Tu Experiencia Sin Límites</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Equipos Wi-Fi Gigabit que entregan la máxima velocidad simétrica. Disfrutá de streaming 4K instantáneo, videollamadas fluidas y gaming competitivo.
          </p>
          <div class="mt-4 inline-flex items-center gap-2 text-xs font-mono text-[#FC0432] bg-red-50 px-3 py-1 rounded-lg font-semibold border border-red-200">
            <span>●</span> Latencia en Trujillo: &lt; 6 ms
          </div>
        </div>

      </div>

      <!-- Right: Sticky Live Visualizer changing with scroll -->
      <div class="lg:col-span-6 lg:sticky lg:top-28">
        <div class="bg-slate-900 rounded-3xl p-8 text-white shadow-2xl relative overflow-hidden min-h-[420px] flex flex-col justify-between border border-slate-800">
          
          <!-- Top info -->
          <div class="flex items-center justify-between border-b border-slate-800 pb-4">
            <div class="flex items-center gap-2">
              <span id="visual-status-dot" class="w-2.5 h-2.5 rounded-full bg-[#FC0432] animate-ping"></span>
              <span id="visual-phase-title" class="font-mono text-xs font-bold text-slate-300 uppercase tracking-wider">Fase 1: Conexión Troncal</span>
            </div>
            <span id="visual-metric-badge" class="text-xs font-mono text-cyan-400 bg-cyan-950/60 px-2.5 py-1 rounded border border-cyan-500/30">10 Gbps Backbone</span>
          </div>

          <!-- Central Animated Wave / Fiber Beam -->
          <div class="py-12 text-center relative flex flex-col items-center justify-center">
            
            <div class="relative w-56 h-56 flex items-center justify-center">
              
              <!-- Dynamic Pulse SVG Rings -->
              <svg class="w-full h-full" viewBox="0 0 100 100">
                <circle cx="50" cy="50" r="45" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="2" />
                <circle id="tech-pulse-ring" cx="50" cy="50" r="35" fill="none" stroke="#FC0432" stroke-width="3" stroke-dasharray="220" stroke-dashoffset="60" />
                <circle cx="50" cy="50" r="22" fill="none" stroke="rgba(10,85,159,0.3)" stroke-width="2" />
              </svg>

              <!-- Central dynamic icon & metric -->
              <div class="absolute inset-0 flex flex-col items-center justify-center space-y-1">
                <span id="visual-speed-value" class="text-4xl sm:text-5xl font-black font-mono tracking-tight text-white">100%</span>
                <span id="visual-speed-label" class="text-[11px] font-mono text-slate-400 uppercase tracking-widest">Capacidad Óptica</span>
              </div>

            </div>

          </div>

          <!-- Bottom Phase Diagnostics -->
          <div class="grid grid-cols-2 gap-3 pt-4 border-t border-slate-800 text-xs font-mono">
            <div class="bg-black/40 rounded-xl p-3 border border-white/5">
              <span class="text-slate-500 block text-[10px]">Latencia Medida</span>
              <span id="visual-lat-val" class="font-bold text-emerald-400 text-sm mt-0.5 block">2.1 ms</span>
            </div>
            <div class="bg-black/40 rounded-xl p-3 border border-white/5">
              <span class="text-slate-500 block text-[10px]">Paquetes Perdidos</span>
              <span id="visual-loss-val" class="font-bold text-cyan-400 text-sm mt-0.5 block">0.00%</span>
            </div>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  import { animate } from 'animejs';

  // Detección de scroll para sincronizar las 3 fases interactivas
  const steps = [
    document.getElementById('tech-step-1'),
    document.getElementById('tech-step-2'),
    document.getElementById('tech-step-3')
  ];

  const phaseTitle = document.getElementById('visual-phase-title');
  const metricBadge = document.getElementById('visual-metric-badge');
  const speedVal = document.getElementById('visual-speed-value');
  const speedLabel = document.getElementById('visual-speed-label');
  const pulseRing = document.getElementById('tech-pulse-ring');
  const latVal = document.getElementById('visual-lat-val');
  const dot = document.getElementById('visual-status-dot');

  const phaseData = [
    {
      title: "Fase 1: Conexión Troncal Valera",
      badge: "10 Gbps Troncal",
      speed: "100%",
      label: "Capacidad Óptica",
      ringColor: "#FC0432",
      lat: "2.1 ms",
      dotColor: "#FC0432",
      borderColor: "border-[#FC0432]"
    },
    {
      title: "Fase 2: Distribución FTTH Pura",
      badge: "Cero Atenuación",
      speed: "1000",
      label: "Mbps en Cable",
      ringColor: "#0A559F",
      lat: "4.3 ms",
      dotColor: "#0A559F",
      borderColor: "border-[#0A559F]"
    },
    {
      title: "Fase 3: Terminal en tu Casa/Empresa",
      badge: "Streaming 4K + Gaming",
      speed: "500",
      label: "Mbps Simétricos",
      ringColor: "#10B981",
      lat: "5.8 ms",
      dotColor: "#10B981",
      borderColor: "border-emerald-500"
    }
  ];

  let currentActive = 0;

  function updateActivePhase(index: number) {
    if (currentActive === index) return;
    currentActive = index;

    // Actualizar estilos de las tarjetas izquierdas
    steps.forEach((step, i) => {
      if (!step) return;
      if (i === index) {
        step.classList.remove('opacity-60', 'border-slate-200');
        step.classList.add('opacity-100', phaseData[index].borderColor, 'bg-white', 'shadow-lg');
      } else {
        step.classList.add('opacity-60', 'border-slate-200');
        step.classList.remove('opacity-100', 'border-[#FC0432]', 'border-[#0A559F]', 'border-emerald-500', 'bg-white', 'shadow-lg');
      }
    });

    // Animar la tarjeta de monitoreo derecha
    const data = phaseData[index];
    if (phaseTitle) phaseTitle.innerText = data.title;
    if (metricBadge) metricBadge.innerText = data.badge;
    if (speedVal) speedVal.innerText = data.speed;
    if (speedLabel) speedLabel.innerText = data.label;
    if (latVal) latVal.innerText = data.lat;

    if (pulseRing) {
      pulseRing.setAttribute('stroke', data.ringColor);
      animate(pulseRing, {
        strokeDashoffset: [220, 40],
        duration: 800,
        ease: 'outExpo'
      });
    }

    if (dot) {
      dot.style.backgroundColor = data.dotColor;
    }
  }

  // Observer para las tarjetas de paso
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        if (id === 'tech-step-1') updateActivePhase(0);
        if (id === 'tech-step-2') updateActivePhase(1);
        if (id === 'tech-step-3') updateActivePhase(2);
      }
    });
  }, { threshold: 0.55 });

  steps.forEach(s => s && observer.observe(s));
</script>
