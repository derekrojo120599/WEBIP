---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 backdrop-blur-xl bg-white/95 border-b border-slate-200/80 shadow-xs">
  <!-- Top bar corporativo -->
  <div class="hidden lg:block bg-slate-900 border-b border-slate-800 text-xs text-slate-300 py-2 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-6">
        <span class="flex items-center gap-1.5"><span class="text-[#FC0432]">📍</span> Calle 13, Valera 3101, Trujillo</span>
        <span class="flex items-center gap-1.5"><span class="text-[#FC0432]">🕒</span> Lun - Sáb: 8:00 AM - 5:00 PM</span>
        <span class="flex items-center gap-1.5 font-medium"><span class="text-emerald-400">●</span> Conatel HGTS-00565</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="tel:02712210316" class="hover:text-white transition-colors">0271-2210316</a>
        <span class="text-slate-600">|</span>
        <a href="https://www.instagram.com/ipsistemas.ve/" target="_blank" class="hover:text-[#FC0432] transition-colors">@ipsistemas.ve</a>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    
    <!-- Logo SVG Oficial de IP Sistemas sobre fondo blanco -->
    <a href="/" class="flex items-center gap-3 group">
      <img 
        src="/icons/Logo%20color.svg" 
        alt="IP Sistemas C.A. Logo" 
        class="h-10 sm:h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-700">
      <a href="#planes" class="hover:text-[#FC0432] transition-colors">Planes</a>
      <a href="#cobertura" class="hover:text-[#FC0432] transition-colors">Cobertura</a>
      <a href="#faq" class="hover:text-[#FC0432] transition-colors">Preguntas</a>
      <a href="tel:02712210316" class="hover:text-[#FC0432] transition-colors">Contacto</a>
    </nav>

    <!-- Action CTAs -->
    <div class="flex items-center gap-3 sm:gap-4">
      <a 
        href="https://portal.ipsistemas.com.ve" 
        target="_blank" 
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-[#0A559F] bg-blue-50 border border-blue-200 hover:bg-[#0A559F] hover:text-white transition-all duration-200 shadow-xs"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="14" x="2" y="5" rx="2"></rect>
          <line x1="2" x2="22" y1="10" y2="10"></line>
        </svg>
        Portal de Pagos
      </a>
      
      <a 
        href="https://wa.me/584260337589?text=Hola,%20deseo%20información%20sobre%20sus%20planes%20de%20internet" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-[#FC0432] to-[#DF0E0E] hover:from-[#ff2b52] hover:to-[#FC0432] shadow-md shadow-[#FC0432]/25 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
      >
        Contratar
      </a>
    </div>

  </div>
</header>
