          <li class="flex items-center gap-1.5"><span class="text-[#FC0432]">●</span> La Mesa de Esnujaque</li>
          <li class="flex items-center gap-1.5"><span class="text-[#FC0432]">●</span> Cabimbú</li>
          <li class="flex items-center gap-1.5"><span class="text-[#FC0432]">●</span> Cuicas - La Cuchilla - Lomas de Bonilla</li>
          <li class="flex items-center gap-1.5"><span class="text-[#FC0432]">●</span> Burbusay & Mesa de los Morenos</li>
        </ul>
      </div>

      <!-- Contact & Office -->
