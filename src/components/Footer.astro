<footer class="bg-[#03060c] border-t border-white/5 pt-16 pb-12 text-slate-400 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 pb-12 border-b border-white/5">
      
      <!-- Company Info -->
      <div class="space-y-4">
        <a href="/" class="inline-block">
          <img 
            src="/icons/Logo%20Blanco.svg" 
            alt="IP Sistemas C.A. Logo Blanco" 
            class="h-10 w-auto object-contain"
          />
