        <h4 class="font-bold text-white mb-4 text-xs uppercase tracking-wider">Atención al Cliente</h4>
        <ul class="space-y-2.5 text-xs">
          <li class="flex items-start gap-2">
            <span class="text-[#FC0432]">📍</span>
            <span>Calle 13, Valera 3101, Trujillo, Venezuela</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-[#FC0432]">📞</span>
            <a href="tel:02712210316" class="hover:text-white">0271-2210316</a> / <a href="tel:04260337589" class="hover:text-white">0426-0337589</a>
