<!-- QuickPay.astro: Bloque de acción inmediata tipo Jio ("Consulta tu factura / Portal de Pagos") -->
<div class="w-full max-w-4xl mx-auto px-4 sm:px-6 my-6 relative z-20">
  <div class="p-6 rounded-3xl bg-gradient-to-r from-blue-900 to-[#0C1020] text-white shadow-xl border border-blue-800/60 flex flex-col md:flex-row items-center justify-between gap-6">
    
    <div class="flex items-center gap-4 text-left">
      <div class="w-12 h-12 rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center text-2xl shrink-0">
        💳
      </div>
      <div>
        <span class="text-xs font-mono font-bold text-[#38bdf8] uppercase tracking-wider block">Autogestión de Clientes</span>
        <h4 class="text-lg sm:text-xl font-black text-white">¿Ya eres cliente de IP Sistemas?</h4>
        <p class="text-xs text-slate-300">Paga tu mensualidad o consulta tu estado de cuenta las 24 horas.</p>
      </div>
    </div>

    <div class="flex items-center gap-3 w-full md:w-auto">
      <a 
        href="https://portal.ipsistemas.com.ve" 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-full md:w-auto px-6 py-3 rounded-xl text-xs sm:text-sm font-bold text-slate-950 bg-white hover:bg-slate-100 shadow-md uppercase tracking-wider text-center transition-all hover:scale-105 active:scale-95"
      >
        Ir a Portal de Pagos →
      </a>
    </div>

  </div>
</div>
