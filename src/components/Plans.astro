---
---

<section id="planes" class="py-24 relative overflow-hidden bg-[#070b16]">
  <!-- Glow accent -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[40rem] h-[25rem] bg-cyan-500/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-cyan-950/40 border border-cyan-500/30 text-xs text-cyan-300 font-mono uppercase tracking-wider">
        Planes & Conectividad
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Elegí la velocidad perfecta para <span class="text-gradient-cyan">tu estilo de vida</span>
      </h2>
      <p class="text-slate-400 text-base sm:text-lg">
        Sin límites de consumo, con tecnología de fibra óptica pura hasta tu hogar o negocio.
      </p>
    </div>

    <!-- Plans Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Plan 1: Hogar Esencial Inalámbrico / Fibra Inicial -->
      <div class="plan-card glass-panel rounded-3xl p-8 flex flex-col justify-between hover:border-slate-500/40 transition-all duration-300 relative group">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-400">Residencial Inicial</span>
            <span class="px-2.5 py-1 rounded-full text-[11px] font-mono bg-slate-800 text-slate-300 border border-white/10">Básico</span>
          </div>

          <h3 class="text-2xl font-black text-white">Plan Esencial</h3>
          <p class="text-xs text-slate-400 mt-1 mb-6">Ideal para navegación diaria, redes sociales y tareas del hogar.</p>

          <div class="flex items-baseline gap-1 my-4">
            <span class="text-5xl font-black text-white font-mono">50</span>
            <span class="text-lg font-bold text-cyan-400 font-mono">MB</span>
          </div>

          <ul class="space-y-3 pt-6 border-t border-white/10 text-xs text-slate-300">
            <li class="flex items-center gap-2.5">
              <span class="text-cyan-400 font-bold">✓</span> Conexión Estable y Continua
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-cyan-400 font-bold">✓</span> Soporte Técnico en Valera
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-cyan-400 font-bold">✓</span> Router Wi-Fi incluido
            </li>
            <li class="flex items-center gap-2.5 text-slate-500">
              <span>✕</span> IP Pública Fija (opcional)
            </li>
          </ul>
        </div>

        <div class="pt-8">
          <a 
            href="https://wa.me/584260337589?text=Hola,%20me%20interesa%20contratar%20el%20Plan%20Esencial%2050MB" 
            target="_blank"
            class="w-full py-3.5 px-4 rounded-xl text-xs font-bold text-slate-200 bg-white/5 border border-white/10 hover:bg-white/10 hover:border-cyan-400/40 transition-all block text-center uppercase tracking-wider"
          >
            Solicitar Plan
          </a>
        </div>
      </div>

      <!-- Plan 2: Fibra Ultra Familiar (Destacado) -->
      <div class="plan-card glass-panel-glow rounded-3xl p-8 flex flex-col justify-between relative transform md:-translate-y-2 border-cyan-500/40">
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-gradient-to-r from-cyan-400 to-blue-500 text-slate-950 text-[11px] font-extrabold uppercase tracking-widest px-4 py-1 rounded-full shadow-lg">
          Más Popular
        </div>

        <div>
          <div class="flex items-center justify-between mb-4 mt-2">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-cyan-400">Fibra Óptica FTTH</span>
            <span class="px-2.5 py-1 rounded-full text-[11px] font-mono bg-cyan-950/80 text-cyan-300 border border-cyan-500/40 font-bold">Simétrico</span>
          </div>

          <h3 class="text-2xl font-black text-white">Plan Fibra Turbo</h3>
          <p class="text-xs text-slate-400 mt-1 mb-6">Máximo rendimiento para streaming 4K simultáneo, gaming y teletrabajo.</p>

          <div class="flex items-baseline gap-1 my-4">
            <span class="text-5xl font-black text-cyan-300 font-mono">200</span>
            <span class="text-lg font-bold text-cyan-400 font-mono">MB</span>
          </div>

          <ul class="space-y-3 pt-6 border-t border-cyan-500/20 text-xs text-slate-200">
            <li class="flex items-center gap-2.5">
              <span class="text-cyan-400 font-bold">✓</span> Velocidad Simétrica (Subida y Bajada)
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-cyan-400 font-bold">✓</span> Latencia Ultra Baja para Juegos Online
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-cyan-400 font-bold">✓</span> Conexión Directa por Fibra Óptica
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-cyan-400 font-bold">✓</span> Soporte Prioritario 24/7
            </li>
          </ul>
        </div>

        <div class="pt-8">
          <a 
            href="https://wa.me/584260337589?text=Hola,%20me%20interesa%20contratar%20el%20Plan%20Fibra%20Turbo%20200MB" 
            target="_blank"
            class="w-full py-4 px-4 rounded-xl text-xs font-black text-slate-950 bg-gradient-to-r from-cyan-400 via-cyan-300 to-blue-400 hover:from-cyan-300 hover:to-blue-300 shadow-lg shadow-cyan-500/30 transition-all block text-center uppercase tracking-wider"
          >
            Contratar Fibra Turbo
          </a>
        </div>
      </div>

      <!-- Plan 3: Corporativo / Enlace Dedicado -->
      <div class="plan-card glass-panel rounded-3xl p-8 flex flex-col justify-between hover:border-slate-500/40 transition-all duration-300">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-purple-400">Corporativo & Pymes</span>
            <span class="px-2.5 py-1 rounded-full text-[11px] font-mono bg-purple-950/60 text-purple-300 border border-purple-500/30">SLA 99.9%</span>
          </div>

          <h3 class="text-2xl font-black text-white">Enlace Dedicado</h3>
          <p class="text-xs text-slate-400 mt-1 mb-6">Ancho de banda 100% exclusivo con monitoreo en tiempo real y soporte corporativo.</p>

          <div class="flex items-baseline gap-1 my-4">
            <span class="text-4xl sm:text-5xl font-black text-white font-mono">Personalizado</span>
          </div>

          <ul class="space-y-3 pt-6 border-t border-white/10 text-xs text-slate-300">
            <li class="flex items-center gap-2.5">
              <span class="text-purple-400 font-bold">✓</span> Canal 1:1 Sin Compartición
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-purple-400 font-bold">✓</span> Bloque de IPs Públicas Estáticas
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-purple-400 font-bold">✓</span> Atención y Técnico Asignado Dedicado
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-purple-400 font-bold">✓</span> Facturación Corporativa Fiscal
            </li>
          </ul>
        </div>

        <div class="pt-8">
          <a 
            href="https://wa.me/584260337589?text=Hola,%20solicito%20cotización%20para%20un%20Enlace%20Dedicado%20Empresarial" 
            target="_blank"
            class="w-full py-3.5 px-4 rounded-xl text-xs font-bold text-purple-300 bg-purple-950/40 border border-purple-500/30 hover:bg-purple-500/20 hover:border-purple-400 transition-all block text-center uppercase tracking-wider"
          >
            Cotizar Corporativo
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
