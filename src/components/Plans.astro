---
---

<section id="planes" class="py-24 relative overflow-hidden bg-slate-50 border-y border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-red-50 border border-red-200 text-xs text-[#FC0432] font-semibold uppercase tracking-wider">
        Planes & Servicios
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        Conexión a tu medida con <span class="text-gradient-ip">IP SISTEMAS</span>
      </h2>
      <p class="text-slate-600 text-base sm:text-lg">
        Disfruta de la mejor estabilidad para tu hogar, comercio o empresa en todo el estado Trujillo.
      </p>
    </div>

    <!-- Plans Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Plan 1: Hogar Inalámbrico -->
      <div class="plan-card card-white rounded-3xl p-8 flex flex-col justify-between hover:shadow-xl hover:border-slate-300 transition-all duration-300 relative group">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500">Inalámbrico</span>
            <span class="px-2.5 py-1 rounded-full text-[11px] font-mono bg-slate-100 text-slate-700 border border-slate-200 font-semibold">Hogar 10 MB</span>
          </div>

          <h3 class="text-2xl font-black text-slate-900">Plan Hogar</h3>
          <p class="text-xs text-slate-500 mt-1 mb-6 leading-relaxed">Tu vida conectada inalámbricamente con cobertura en zonas rurales y urbanas.</p>

          <div class="flex items-baseline gap-1 my-4">
            <span class="text-5xl font-black text-slate-900 font-mono">10</span>
            <span class="text-lg font-bold text-[#FC0432] font-mono">MB</span>
          </div>

          <ul class="space-y-3 pt-6 border-t border-slate-100 text-xs text-slate-600 font-medium">
            <li class="flex items-center gap-2.5">
              <span class="text-[#FC0432] font-bold">✓</span> Conexión Estable Inalámbrica
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-[#FC0432] font-bold">✓</span> Soporte Técnico en Valera
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-[#FC0432] font-bold">✓</span> Navegación Ilimitada
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-[#FC0432] font-bold">✓</span> Acceso al Portal de Pagos
            </li>
          </ul>
        </div>

        <div class="pt-8">
          <a 
            href="https://wa.me/584260337589?text=Hola,%20me%20interesa%20contratar%20el%20Plan%20Hogar%2010MB" 
            target="_blank"
            class="w-full py-3.5 px-4 rounded-xl text-xs font-bold text-slate-800 bg-slate-100 hover:bg-[#FC0432] hover:text-white transition-all block text-center uppercase tracking-wider"
          >
            Solicitar Plan Hogar
          </a>
        </div>
      </div>

      <!-- Plan 2: Fibra Óptica (Destacado) -->
      <div class="plan-card card-white-featured rounded-3xl p-8 flex flex-col justify-between relative transform md:-translate-y-2">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-gradient-to-r from-[#FC0432] to-[#DF0E0E] text-white text-[11px] font-black uppercase tracking-widest px-4 py-1 rounded-full shadow-md">
          Más Popular
        </div>

        <div>
          <div class="flex items-center justify-between mb-4 mt-2">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#FC0432]">Fibra Óptica</span>
            <span class="px-2.5 py-1 rounded-full text-[11px] font-mono bg-red-50 text-[#FC0432] border border-red-200 font-bold">Alta Velocidad</span>
          </div>

          <h3 class="text-2xl font-black text-slate-900">Plan Fibra</h3>
          <p class="text-xs text-slate-500 mt-1 mb-6 leading-relaxed">Disfruta desde 20 hasta 80 MB para streaming en alta definición y teletrabajo.</p>

          <div class="flex items-baseline gap-1 my-4">
            <span class="text-5xl font-black text-slate-900 font-mono">20 - 80</span>
            <span class="text-lg font-bold text-[#FC0432] font-mono">MB</span>
          </div>

          <ul class="space-y-3 pt-6 border-t border-red-100 text-xs text-slate-700 font-medium">
            <li class="flex items-center gap-2.5">
              <span class="text-[#FC0432] font-bold">✓</span> Conexión Directa por Fibra Óptica
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-[#FC0432] font-bold">✓</span> Mayor Estabilidad para Teletrabajo
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-[#FC0432] font-bold">✓</span> Múltiples Dispositivos Conectados
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-[#FC0432] font-bold">✓</span> Atención Prioritaria
            </li>
          </ul>
        </div>

        <div class="pt-8">
          <a 
            href="https://wa.me/584260337589?text=Hola,%20me%20interesa%20contratar%20el%20Plan%20Fibra" 
            target="_blank"
            class="w-full py-4 px-4 rounded-xl text-xs font-black text-white bg-gradient-to-r from-[#FC0432] to-[#DF0E0E] hover:from-[#ff2b52] hover:to-[#FC0432] shadow-md shadow-[#FC0432]/25 transition-all block text-center uppercase tracking-wider"
          >
            Contratar Plan Fibra
          </a>
        </div>
      </div>

      <!-- Plan 3: Soluciones Dedicadas Empresariales -->
      <div class="plan-card card-white rounded-3xl p-8 flex flex-col justify-between hover:shadow-xl hover:border-slate-300 transition-all duration-300">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#0A559F]">Corporativo</span>
            <span class="px-2.5 py-1 rounded-full text-[11px] font-mono bg-blue-50 text-[#0A559F] border border-blue-200 font-semibold">SLA Garantizado</span>
          </div>

          <h3 class="text-2xl font-black text-slate-900">Soluciones Dedicadas</h3>
          <p class="text-xs text-slate-500 mt-1 mb-6 leading-relaxed">Conexión exclusiva para su negocio que garantiza la transferencia de internet y datos.</p>

          <div class="flex items-baseline gap-1 my-4">
            <span class="text-4xl sm:text-5xl font-black text-slate-900 font-mono">Dedicado</span>
          </div>

          <ul class="space-y-3 pt-6 border-t border-slate-100 text-xs text-slate-600 font-medium">
            <li class="flex items-center gap-2.5">
              <span class="text-[#0A559F] font-bold">✓</span> Enlace 1:1 Exclusivo para Empresas
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-[#0A559F] font-bold">✓</span> Soporte Especializado Corporativo
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-[#0A559F] font-bold">✓</span> Conexión para Productores y Comercios
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-[#0A559F] font-bold">✓</span> Facturación Fiscal Personalizada
            </li>
          </ul>
        </div>

        <div class="pt-8">
          <a 
            href="https://wa.me/584260337589?text=Hola,%20solicito%20presupuesto%20para%20Soluciones%20Dedicadas%20Empresariales" 
            target="_blank"
            class="w-full py-3.5 px-4 rounded-xl text-xs font-bold text-[#0A559F] bg-blue-50 hover:bg-[#0A559F] hover:text-white transition-all block text-center uppercase tracking-wider"
          >
            Solicitar Presupuesto
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
