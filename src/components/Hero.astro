---
---

<section class="relative min-h-[90vh] flex items-center justify-center pt-24 pb-20 overflow-hidden bg-radial-mesh">
  <!-- Interactive Ambient Fiber Glows -->
  <div class="hero-glow-1 absolute -top-40 -left-40 w-96 h-96 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="hero-glow-2 absolute top-1/2 -right-40 w-[30rem] h-[30rem] bg-indigo-600/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Hero Left Copy -->
      <div class="lg:col-span-7 text-center lg:text-left space-y-6">
        
        <div class="hero-badge inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-950/50 border border-cyan-500/30 text-xs text-cyan-300 font-mono tracking-wide shadow-inner">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
          <span>FIBRA ÓPTICA DIRECTA HASTA EL HOGAR (FTTH)</span>
        </div>

        <h1 class="hero-title text-4xl sm:text-6xl font-extrabold tracking-tight leading-[1.1] text-white">
          La velocidad que <br class="hidden sm:inline" />
          <span class="text-gradient-cyan">transforma tu mundo.</span>
        </h1>

        <p class="hero-desc text-base sm:text-lg text-slate-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
          Conexión simétrica de ultra baja latencia para streaming en 4K, teletrabajo sin cortes y soluciones dedicadas para empresas en Valera y todo Trujillo.
        </p>

        <!-- CTA cluster -->
        <div class="hero-cta flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a 
            href="#planes" 
            class="w-full sm:w-auto px-8 py-4 rounded-xl text-base font-bold text-slate-950 bg-gradient-to-r from-cyan-400 via-cyan-300 to-blue-400 hover:from-cyan-300 hover:to-blue-300 shadow-xl shadow-cyan-500/30 hover:scale-[1.02] active:scale-[0.98] transition-all text-center flex items-center justify-center gap-2"
          >
            <span>Ver Planes Disponibles</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <a 
            href="#cobertura" 
            class="w-full sm:w-auto px-6 py-4 rounded-xl text-sm font-semibold text-slate-200 glass-panel hover:bg-white/10 hover:border-cyan-400/40 transition-all text-center"
          >
            Consultar Cobertura
          </a>
        </div>

        <!-- Metrics pill stats -->
        <div class="hero-stats pt-6 grid grid-cols-3 gap-4 border-t border-white/5 max-w-lg mx-auto lg:mx-0">
          <div>
            <div class="text-2xl sm:text-3xl font-black text-cyan-400 font-mono">100%</div>
            <div class="text-xs text-slate-400 mt-0.5">Fibra Simétrica</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-black text-indigo-400 font-mono">&lt; 8ms</div>
            <div class="text-xs text-slate-400 mt-0.5">Baja Latencia</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-black text-emerald-400 font-mono">99.9%</div>
            <div class="text-xs text-slate-400 mt-0.5">Uptime Garantizado</div>
          </div>
        </div>

      </div>

      <!-- Hero Right Interactive Card (Speed & Network Visualizer) -->
      <div class="lg:col-span-5 relative">
        <div class="hero-visual glass-panel-glow rounded-3xl p-6 sm:p-8 relative overflow-hidden">
          
          <div class="flex items-center justify-between pb-6 border-b border-white/10">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="text-xs font-mono font-semibold uppercase text-slate-300">Enlace Activo: Valera Nodo Central</span>
            </div>
            <span class="text-[11px] font-mono text-cyan-400 bg-cyan-950/60 px-2 py-1 rounded">FTTH GIGA</span>
          </div>

          <!-- Central Speed Gauge Visual -->
          <div class="py-8 text-center relative flex flex-col items-center justify-center">
            
            <!-- Orbiting SVG fiber circle -->
            <div class="relative w-48 h-48 flex items-center justify-center">
              <svg class="w-full h-full -rotate-90 transform" viewBox="0 0 100 100">
                <circle class="text-slate-800" stroke-width="6" stroke="currentColor" fill="transparent" r="42" cx="50" cy="50" />
                <circle 
                  id="hero-gauge-circle" 
                  class="text-cyan-400" 
                  stroke-width="7" 
                  stroke-linecap="round" 
                  stroke="currentColor" 
                  fill="transparent" 
                  r="42" 
                  cx="50" 
                  cy="50" 
                  stroke-dasharray="264" 
                  stroke-dashoffset="60"
                />
              </svg>
              
              <div class="absolute inset-0 flex flex-col items-center justify-center">
                <span class="speed-number text-5xl font-black tracking-tight text-white font-mono">500</span>
                <span class="text-xs font-bold text-cyan-400 uppercase tracking-wider -mt-1">Mbps Simétricos</span>
              </div>
            </div>

          </div>

          <!-- Real-time Status meters -->
          <div class="grid grid-cols-2 gap-3 pt-2">
            <div class="bg-black/30 rounded-xl p-3 border border-white/5">
              <div class="text-[11px] text-slate-400">Descarga (Download)</div>
              <div class="text-sm font-bold text-slate-100 font-mono flex items-center gap-1.5 mt-0.5">
                <span class="text-cyan-400">↓</span> 500.2 Mbps
              </div>
            </div>
            <div class="bg-black/30 rounded-xl p-3 border border-white/5">
              <div class="text-[11px] text-slate-400">Subida (Upload)</div>
              <div class="text-sm font-bold text-slate-100 font-mono flex items-center gap-1.5 mt-0.5">
                <span class="text-emerald-400">↑</span> 500.0 Mbps
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import { animate } from 'animejs';

  // Smooth entrance sequence using Anime.js
  animate('.hero-badge', {
    opacity: [0, 1],
    translateY: [-20, 0],
    duration: 600,
    ease: 'outQuad'
  });

  animate('.hero-title', {
    opacity: [0, 1],
    translateY: [30, 0],
    duration: 800,
    delay: 150,
    ease: 'outQuad'
  });

  animate('.hero-desc', {
    opacity: [0, 1],
    translateY: [20, 0],
    duration: 700,
    delay: 300,
    ease: 'outQuad'
  });

  animate('.hero-cta', {
    opacity: [0, 1],
    translateY: [20, 0],
    duration: 600,
    delay: 450,
    ease: 'outQuad'
  });

  animate('.hero-stats', {
    opacity: [0, 1],
    duration: 800,
    delay: 600,
    ease: 'outQuad'
  });

  animate('.hero-visual', {
    opacity: [0, 1],
    scale: [0.92, 1],
    duration: 1000,
    delay: 200,
    ease: 'outExpo'
  });
</script>
