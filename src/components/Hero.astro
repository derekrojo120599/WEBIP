<section class="relative min-h-[92vh] flex items-center justify-center pt-28 pb-20 overflow-hidden bg-radial-mesh-light">
  <!-- Interactive Canvas para partículas de fibra óptica reactivas al mouse -->
  <canvas id="hero-particles-canvas" class="absolute inset-0 w-full h-full pointer-events-auto z-0"></canvas>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="max-w-4xl mx-auto text-center space-y-8">
      
      <!-- Badge Conatel / Estado -->
      <div class="hero-badge inline-flex items-center gap-2 px-4 py-2 rounded-full bg-red-50 border border-red-200/80 text-xs text-[#FC0432] font-semibold tracking-wide shadow-xs">
        <span class="w-2.5 h-2.5 rounded-full bg-[#FC0432] animate-ping"></span>
        <span>INTERNET DE ALTA VELOCIDAD & FIBRA ÓPTICA EN TRUJILLO</span>
      </div>

      <!-- Main Headline -->
      <h1 class="hero-title text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight leading-[1.12] text-slate-900">
        Vive una experiencia <br />
        <span class="text-gradient-ip">de otro nivel.</span>
      </h1>

      <!-- Description -->
      <p class="hero-desc text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed font-normal">
        Conexión de fibra óptica simétrica y soluciones inalámbricas de alto rendimiento para el hogar, la educación y empresas en todo el estado Trujillo.
      </p>

      <!-- Action Buttons -->
      <div class="hero-cta flex flex-col sm:flex-row items-center justify-center gap-4 pt-1">
        <a 
          href="#planes" 
          class="w-full sm:w-auto px-8 py-4 rounded-xl text-base font-bold text-white bg-gradient-to-r from-[#FC0432] via-[#ff2b52] to-[#DF0E0E] hover:from-[#ff2b52] hover:to-[#FC0432] shadow-xl shadow-[#FC0432]/25 hover:scale-[1.02] active:scale-[0.98] transition-all text-center flex items-center justify-center gap-2"
        >
          <span>Ver Planes Disponibles</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a 
          href="https://portal.ipsistemas.com.ve" 
          target="_blank"
          class="w-full sm:w-auto px-8 py-4 rounded-xl text-base font-bold text-[#0A559F] bg-blue-50 border border-blue-200 hover:bg-[#0A559F] hover:text-white transition-all text-center"
        >
          Portal de Pagos
        </a>
      </div>

      <!-- PROPUESTA 3: Router Óptico Flotante con Nodos y Ondas de Señal Vivas -->
      <div class="pt-6 max-w-2xl mx-auto relative">
        
        <!-- Contenedor del dispositivo flotante -->
        <div id="router-container" class="relative bg-white/90 backdrop-blur-md rounded-3xl border border-slate-200 shadow-2xl p-8 overflow-hidden transition-transform duration-300">
          
          <!-- Ondas de señal Wi-Fi / Fibra en el fondo del mockup -->
          <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-40">
            <div class="w-64 h-64 rounded-full border-2 border-red-200 animate-ping" style="animation-duration: 3s;"></div>
            <div class="absolute w-44 h-44 rounded-full border-2 border-blue-200 animate-ping" style="animation-duration: 2s;"></div>
          </div>

          <div class="relative z-10 flex flex-col sm:flex-row items-center justify-between gap-6">
            
            <!-- Router Visual Mockup Digital -->
            <div id="floating-router-mockup" class="w-32 h-32 rounded-2xl bg-gradient-to-tr from-slate-900 to-slate-800 p-4 shadow-xl flex flex-col justify-between text-white relative transition-transform">
              <div class="flex items-center justify-between">
                <div class="flex gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span class="w-2 h-2 rounded-full bg-[#FC0432] animate-pulse" style="animation-delay: 200ms;"></span>
                  <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse" style="animation-delay: 400ms;"></span>
                </div>
                <span class="text-[9px] font-mono text-slate-400">Wi-Fi 6</span>
              </div>

              <!-- Antenas / Isotipo -->
              <div class="text-center py-2">
                <span class="text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-[#FC0432] to-[#38bdf8] font-mono">
                  FTTH
                </span>
                <span class="text-[8px] font-mono text-slate-400 block tracking-widest">GIGABIT ONU</span>
              </div>

              <div class="text-[9px] font-mono text-emerald-400 text-center bg-black/40 rounded py-0.5 border border-white/5">
                ● ONLINE 100%
              </div>
            </div>

            <!-- Nodos y Tags Orbitantes de Métricas -->
            <div class="grid grid-cols-2 gap-3 flex-1 text-left">
              
              <div class="p-3 rounded-xl bg-red-50/70 border border-red-200/80 hover:scale-105 transition-transform">
                <div class="flex items-center gap-1.5">
                  <span class="text-xs">⚡</span>
                  <span class="text-[11px] font-mono font-bold text-[#FC0432] uppercase">500 Mbps</span>
                </div>
                <span class="text-[10px] text-slate-600 block mt-0.5 font-medium">Fibra Simétrica Pura</span>
              </div>

              <div class="p-3 rounded-xl bg-blue-50/70 border border-blue-200/80 hover:scale-105 transition-transform">
                <div class="flex items-center gap-1.5">
                  <span class="text-xs">🎯</span>
                  <span class="text-[11px] font-mono font-bold text-[#0A559F] uppercase">&lt; 8ms Ping</span>
                </div>
                <span class="text-[10px] text-slate-600 block mt-0.5 font-medium">Baja Latencia Gaming</span>
              </div>

              <div class="p-3 rounded-xl bg-emerald-50/70 border border-emerald-200/80 hover:scale-105 transition-transform">
                <div class="flex items-center gap-1.5">
                  <span class="text-xs">📶</span>
                  <span class="text-[11px] font-mono font-bold text-emerald-700 uppercase">Wi-Fi 6 Doble</span>
                </div>
                <span class="text-[10px] text-slate-600 block mt-0.5 font-medium">2.4GHz + 5.8GHz</span>
              </div>

              <div class="p-3 rounded-xl bg-purple-50/70 border border-purple-200/80 hover:scale-105 transition-transform">
                <div class="flex items-center gap-1.5">
                  <span class="text-xs">🛡️</span>
                  <span class="text-[11px] font-mono font-bold text-purple-700 uppercase">SLA 99.9%</span>
                </div>
                <span class="text-[10px] text-slate-600 block mt-0.5 font-medium">Uptime Ininterrumpido</span>
              </div>

            </div>

          </div>

        </div>

      </div>

    </div>
  </div>
</section>

<script>
  import { animate } from 'animejs';

  // Animaciones de entrada iniciales
  animate('.hero-badge, .hero-title, .hero-desc, .hero-cta', {
    opacity: [0, 1],
    translateY: [20, 0],
    delay: (el, i) => i * 120,
    duration: 600,
    ease: 'outQuad'
  });

  // Animación de levitación continua para el router
  const routerMockup = document.getElementById('floating-router-mockup');
  if (routerMockup) {
    animate(routerMockup, {
      translateY: [-6, 6],
      duration: 2400,
      direction: 'alternate',
      loop: true,
      ease: 'inOutSine'
    });
  }

  // Canvas interactivo de partículas flotantes
  const canvas = document.getElementById('hero-particles-canvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    let width = (canvas.width = canvas.offsetWidth);
    let height = (canvas.height = canvas.offsetHeight);

    window.addEventListener('resize', () => {
      width = canvas.width = canvas.offsetWidth;
      height = canvas.height = canvas.offsetHeight;
    });

    const colors = ['rgba(252, 4, 50, ', 'rgba(10, 85, 159, ', 'rgba(0, 150, 255, '];
    const particleCount = Math.min(50, Math.floor(width / 25));
    const particles: any[] = [];

    for (let i = 0; i < particleCount; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.6,
        vy: (Math.random() - 0.5) * 0.6,
        radius: Math.random() * 2.2 + 1,
        colorBase: colors[Math.floor(Math.random() * colors.length)],
        alpha: Math.random() * 0.35 + 0.15
      });
    }

    const mouse = { x: -1000, y: -1000, radius: 120 };

    window.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    });

    function render() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < 100) {
            ctx.beginPath();
            ctx.strokeStyle = `rgba(10, 85, 159, ${0.1 * (1 - dist / 100)})`;
            ctx.lineWidth = 0.8;
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.stroke();
          }
        }
      }

      particles.forEach((p) => {
        p.x += p.vx;
        p.y += p.vy;

        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;

        const dx = mouse.x - p.x;
        const dy = mouse.y - p.y;
        const distance = Math.sqrt(dx * dx + dy * dy);

        if (distance < mouse.radius) {
          const force = (mouse.radius - distance) / mouse.radius;
          const angle = Math.atan2(dy, dx);
          p.x -= Math.cos(angle) * force * 3;
          p.y -= Math.sin(angle) * force * 3;
        }

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fillStyle = `${p.colorBase}${p.alpha})`;
        ctx.fill();
      });

      requestAnimationFrame(render);
    }

    render();
  }
</script>
