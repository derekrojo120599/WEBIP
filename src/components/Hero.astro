---
---

<section class="relative min-h-[92vh] flex items-center justify-center pt-36 pb-20 overflow-hidden bg-radial-mesh-light">
  <!-- Subtle ambient fiber accents -->
  <div class="absolute -top-32 -left-32 w-96 h-96 bg-red-500/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 -right-32 w-[28rem] h-[28rem] bg-blue-500/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Hero Left Copy -->
      <div class="lg:col-span-7 text-center lg:text-left space-y-6">
        
        <div class="hero-badge inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-50 border border-red-200 text-xs text-[#FC0432] font-semibold tracking-wide shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#FC0432] animate-ping"></span>
          <span>INTERNET DE ALTA VELOCIDAD & FIBRA ÓPTICA EN TRUJILLO</span>
        </div>

        <h1 class="hero-title text-4xl sm:text-6xl font-black tracking-tight leading-[1.15] text-slate-900">
          Vive una experiencia <br class="hidden sm:inline" />
          <span class="text-gradient-ip">de otro nivel.</span>
        </h1>

        <p class="hero-desc text-base sm:text-lg text-slate-600 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
          Conexión de fibra óptica y soluciones inalámbricas estables para la educación de tus hijos, streaming sin interrupciones y soluciones dedicadas para empresas y productores en Valera y todo Trujillo.
        </p>

        <!-- CTA cluster -->
        <div class="hero-cta flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a 
            href="#planes" 
            class="w-full sm:w-auto px-8 py-4 rounded-xl text-base font-bold text-white bg-gradient-to-r from-[#FC0432] via-[#ff2b52] to-[#DF0E0E] hover:from-[#ff2b52] hover:to-[#FC0432] shadow-lg shadow-[#FC0432]/25 hover:scale-[1.02] active:scale-[0.98] transition-all text-center flex items-center justify-center gap-2"
          >
            <span>Ver Planes y Tarifas</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <a 
            href="https://portal.ipsistemas.com.ve" 
            target="_blank"
            class="w-full sm:w-auto px-6 py-4 rounded-xl text-sm font-bold text-[#0A559F] bg-blue-50 border border-blue-200 hover:bg-[#0A559F] hover:text-white transition-all text-center"
          >
            Portal de Pagos
          </a>
        </div>

        <!-- Metrics stats -->
        <div class="hero-stats pt-6 grid grid-cols-3 gap-4 border-t border-slate-200 max-w-lg mx-auto lg:mx-0">
          <div>
            <div class="text-2xl sm:text-3xl font-black text-[#FC0432] font-mono">100%</div>
            <div class="text-xs text-slate-500 mt-0.5 font-medium">Estabilidad Real</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-black text-[#0A559F] font-mono">500 MB</div>
            <div class="text-xs text-slate-500 mt-0.5 font-medium">Velocidad Máxima</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-black text-emerald-600 font-mono">24/7</div>
            <div class="text-xs text-slate-500 mt-0.5 font-medium">Soporte Técnico</div>
          </div>
        </div>

      </div>

      <!-- Hero Right Card (Speed & Network Visualizer) -->
      <div class="lg:col-span-5 relative">
        <div class="hero-visual bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-xl shadow-slate-200/50 relative overflow-hidden">
          
          <div class="flex items-center justify-between pb-6 border-b border-slate-100">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="text-xs font-mono font-bold uppercase text-slate-700">Nodo Central Valera</span>
            </div>
            <span class="text-[11px] font-mono text-white bg-[#FC0432] px-2.5 py-1 rounded-md font-bold shadow-xs">CONATEL HGTS-00565</span>
          </div>

          <!-- Central Speed Gauge Visual -->
          <div class="py-8 text-center relative flex flex-col items-center justify-center">
            
            <div class="relative w-48 h-48 flex items-center justify-center">
              <svg class="w-full h-full -rotate-90 transform" viewBox="0 0 100 100">
                <circle class="text-slate-100" stroke-width="7" stroke="currentColor" fill="transparent" r="42" cx="50" cy="50" />
                <circle 
                  class="text-[#FC0432]" 
                  stroke-width="7" 
                  stroke-linecap="round" 
                  stroke="currentColor" 
                  fill="transparent" 
                  r="42" 
                  cx="50" 
                  cy="50" 
                  stroke-dasharray="264" 
                  stroke-dashoffset="40"
                />
              </svg>
              
              <div class="absolute inset-0 flex flex-col items-center justify-center">
                <span class="speed-number text-5xl font-black tracking-tight text-slate-900 font-mono">500</span>
                <span class="text-xs font-bold text-[#FC0432] uppercase tracking-wider -mt-1">Mbps Máximo</span>
              </div>
            </div>

          </div>

          <!-- Real-time Status meters -->
          <div class="grid grid-cols-2 gap-3 pt-2">
            <div class="bg-slate-50 rounded-xl p-3 border border-slate-200/60">
              <div class="text-[11px] font-semibold text-slate-500">Planes Residenciales</div>
              <div class="text-sm font-bold text-slate-900 font-mono flex items-center gap-1.5 mt-0.5">
                <span class="text-[#FC0432]">●</span> Desde 10 a 80 MB
              </div>
            </div>
            <div class="bg-slate-50 rounded-xl p-3 border border-slate-200/60">
              <div class="text-[11px] font-semibold text-slate-500">Fibra & Dedicados</div>
              <div class="text-sm font-bold text-slate-900 font-mono flex items-center gap-1.5 mt-0.5">
                <span class="text-[#0A559F]">●</span> Hasta 500 MB 1:1
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import { animate } from 'animejs';

  animate('.hero-badge', {
    opacity: [0, 1],
    translateY: [-15, 0],
    duration: 600,
    ease: 'outQuad'
  });

  animate('.hero-title', {
    opacity: [0, 1],
    translateY: [25, 0],
    duration: 700,
    delay: 100,
    ease: 'outQuad'
  });

  animate('.hero-desc', {
    opacity: [0, 1],
    translateY: [20, 0],
    duration: 600,
    delay: 200,
    ease: 'outQuad'
  });

  animate('.hero-cta', {
    opacity: [0, 1],
    translateY: [15, 0],
    duration: 600,
    delay: 300,
    ease: 'outQuad'
  });

  animate('.hero-visual', {
    opacity: [0, 1],
    scale: [0.94, 1],
    duration: 900,
    delay: 150,
    ease: 'outExpo'
  });
</script>
