---
---

<section class="relative min-h-[92vh] flex items-center justify-center pt-32 pb-20 overflow-hidden bg-radial-mesh-light">
  <!-- Interactive Canvas para partículas de fibra óptica reactivas al mouse -->
  <canvas id="hero-particles-canvas" class="absolute inset-0 w-full h-full pointer-events-auto z-0"></canvas>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="max-w-4xl mx-auto text-center space-y-8">
      
      <!-- Badge Conatel / Estado Operativo -->
      <div class="hero-badge inline-flex items-center gap-2 px-4 py-2 rounded-full bg-red-50/90 border border-red-200 text-xs text-[#FC0432] font-semibold tracking-wide shadow-xs backdrop-blur-xs">
        <span class="w-2.5 h-2.5 rounded-full bg-[#FC0432] animate-ping"></span>
        <span class="font-mono">FIBRA ÓPTICA SIMÉTRICA • CONATEL HGTS-00565</span>
      </div>

      <!-- Main Headline Editorial -->
      <h1 class="hero-title text-5xl sm:text-7xl lg:text-8xl font-black tracking-tight leading-[1.08] text-slate-900">
        Vive una experiencia <br />
        <span class="text-gradient-ip">de otro nivel.</span>
      </h1>

      <!-- Subtitle -->
      <p class="hero-desc text-lg sm:text-2xl text-slate-600 max-w-2xl mx-auto leading-relaxed font-normal">
        Conexión de alta velocidad y máxima estabilidad para el hogar, la educación de tus hijos y el crecimiento de empresas en el estado Trujillo.
      </p>

      <!-- Action Buttons -->
      <div class="hero-cta flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a 
          href="#planes" 
          class="w-full sm:w-auto px-8 py-4 rounded-xl text-base font-bold text-white bg-gradient-to-r from-[#FC0432] via-[#ff2b52] to-[#DF0E0E] hover:from-[#ff2b52] hover:to-[#FC0432] shadow-xl shadow-[#FC0432]/25 hover:scale-[1.02] active:scale-[0.98] transition-all text-center flex items-center justify-center gap-2"
        >
          <span>Ver Planes y Tarifas</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a 
          href="https://portal.ipsistemas.com.ve" 
          target="_blank"
          class="w-full sm:w-auto px-8 py-4 rounded-xl text-base font-bold text-[#0A559F] bg-blue-50 border border-blue-200 hover:bg-[#0A559F] hover:text-white transition-all text-center shadow-xs"
        >
          Portal de Pagos
        </a>
      </div>

      <!-- Micro Metrics Bento Pills -->
      <div class="hero-stats pt-10 grid grid-cols-3 gap-4 sm:gap-6 border-t border-slate-200/80 max-w-2xl mx-auto">
        <div class="p-3 sm:p-4 rounded-2xl bg-white/70 border border-slate-200/60 shadow-xs">
          <div class="text-2xl sm:text-4xl font-black text-[#FC0432] font-mono">100%</div>
          <div class="text-[11px] sm:text-xs text-slate-500 mt-1 font-semibold uppercase tracking-wider">Fibra Simétrica</div>
        </div>
        <div class="p-3 sm:p-4 rounded-2xl bg-white/70 border border-slate-200/60 shadow-xs">
          <div class="text-2xl sm:text-4xl font-black text-[#0A559F] font-mono">&lt; 8 ms</div>
          <div class="text-[11px] sm:text-xs text-slate-500 mt-1 font-semibold uppercase tracking-wider">Baja Latencia</div>
        </div>
        <div class="p-3 sm:p-4 rounded-2xl bg-white/70 border border-slate-200/60 shadow-xs">
          <div class="text-2xl sm:text-4xl font-black text-emerald-600 font-mono">24/7</div>
          <div class="text-[11px] sm:text-xs text-slate-500 mt-1 font-semibold uppercase tracking-wider">Soporte Local</div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import { animate } from 'animejs';

  animate('.hero-badge', {
    opacity: [0, 1],
    translateY: [-15, 0],
    duration: 600,
    ease: 'outQuad'
  });

  animate('.hero-title', {
    opacity: [0, 1],
    translateY: [25, 0],
    duration: 700,
    delay: 100,
    ease: 'outQuad'
  });

  animate('.hero-desc', {
    opacity: [0, 1],
    translateY: [20, 0],
    duration: 600,
    delay: 200,
    ease: 'outQuad'
  });

  animate('.hero-cta', {
    opacity: [0, 1],
    translateY: [15, 0],
    duration: 600,
    delay: 300,
    ease: 'outQuad'
  });

  animate('.hero-stats', {
    opacity: [0, 1],
    duration: 800,
    delay: 450,
    ease: 'outQuad'
  });

  // Canvas de partículas interactivas de fibra
  const canvas = document.getElementById('hero-particles-canvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    let width = (canvas.width = canvas.offsetWidth);
    let height = (canvas.height = canvas.offsetHeight);

    window.addEventListener('resize', () => {
      width = canvas.width = canvas.offsetWidth;
      height = canvas.height = canvas.offsetHeight;
    });

    const colors = ['rgba(252, 4, 50, ', 'rgba(10, 85, 159, ', 'rgba(0, 150, 255, '];
    const particleCount = Math.min(60, Math.floor(width / 22));
    const particles: any[] = [];

    for (let i = 0; i < particleCount; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.6,
        vy: (Math.random() - 0.5) * 0.6,
        radius: Math.random() * 2.2 + 1,
        colorBase: colors[Math.floor(Math.random() * colors.length)],
        alpha: Math.random() * 0.35 + 0.15
      });
    }

    const mouse = { x: -1000, y: -1000, radius: 130 };

    window.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    });

    function render() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < 110) {
            ctx.beginPath();
            ctx.strokeStyle = `rgba(10, 85, 159, ${0.1 * (1 - dist / 110)})`;
            ctx.lineWidth = 0.8;
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.stroke();
          }
        }
      }

      particles.forEach((p) => {
        p.x += p.vx;
        p.y += p.vy;

        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;

        const dx = mouse.x - p.x;
        const dy = mouse.y - p.y;
        const distance = Math.sqrt(dx * dx + dy * dy);

        if (distance < mouse.radius) {
          const force = (mouse.radius - distance) / mouse.radius;
          const angle = Math.atan2(dy, dx);
          p.x -= Math.cos(angle) * force * 3.5;
          p.y -= Math.sin(angle) * force * 3.5;
        }

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fillStyle = `${p.colorBase}${p.alpha})`;
        ctx.fill();
      });

      requestAnimationFrame(render);
    }

    render();
  }
</script>
