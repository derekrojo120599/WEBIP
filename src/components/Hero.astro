<!-- Hero.astro: Título con acento rojo + Composición gráfica superpuesta estilo Orbitix -->
<section class="relative min-h-[92vh] flex items-center justify-center pt-36 pb-20 overflow-hidden bg-radial-mesh-light">
  <!-- Partículas interactivas -->
