---
---

<section class="relative min-h-[92vh] flex items-center justify-center pt-28 pb-20 overflow-hidden bg-radial-mesh-light">
  <!-- Interactive Canvas para partículas de fibra óptica reactivas al mouse -->
  <canvas id="hero-particles-canvas" class="absolute inset-0 w-full h-full pointer-events-auto z-0"></canvas>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="max-w-4xl mx-auto text-center space-y-8">
      
      <!-- Badge Conatel / Estado -->
      <div class="hero-badge inline-flex items-center gap-2 px-4 py-2 rounded-full bg-red-50 border border-red-200/80 text-xs text-[#FC0432] font-semibold tracking-wide shadow-xs">
        <span class="w-2.5 h-2.5 rounded-full bg-[#FC0432] animate-ping"></span>
        <span>INTERNET DE ALTA VELOCIDAD & FIBRA ÓPTICA EN TRUJILLO</span>
      </div>

      <!-- Main Headline -->
      <h1 class="hero-title text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight leading-[1.12] text-slate-900">
        Vive una experiencia <br />
        <span class="text-gradient-ip">de otro nivel.</span>
      </h1>

      <!-- Description -->
      <p class="hero-desc text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed font-normal">
        Conexión de fibra óptica simétrica y soluciones inalámbricas de alto rendimiento para el hogar, la educación y empresas en todo el estado Trujillo.
      </p>

      <!-- Action Buttons -->
      <div class="hero-cta flex flex-col sm:flex-row items-center justify-center gap-4 pt-1">
        <a 
          href="#planes" 
          class="w-full sm:w-auto px-8 py-4 rounded-xl text-base font-bold text-white bg-gradient-to-r from-[#FC0432] via-[#ff2b52] to-[#DF0E0E] hover:from-[#ff2b52] hover:to-[#FC0432] shadow-xl shadow-[#FC0432]/25 hover:scale-[1.02] active:scale-[0.98] transition-all text-center flex items-center justify-center gap-2"
        >
          <span>Ver Planes Disponibles</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a 
          href="https://portal.ipsistemas.com.ve" 
          target="_blank"
          class="w-full sm:w-auto px-8 py-4 rounded-xl text-base font-bold text-[#0A559F] bg-blue-50 border border-blue-200 hover:bg-[#0A559F] hover:text-white transition-all text-center"
        >
          Portal de Pagos
        </a>
      </div>

      <!-- PROPUESTA 1: Showcase 3D Card con Efecto Tilt y Tabs de Casos de Uso -->
      <div class="pt-6 max-w-3xl mx-auto">
        <!-- Interactive Tabs Selector -->
        <div class="flex items-center justify-center gap-2 mb-4">
          <button id="tab-btn-1" class="hero-tab-btn active px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider bg-white border-2 border-[#FC0432] text-[#FC0432] shadow-sm transition-all">
            👨‍👩‍👧‍👦 Familia & Hogar
          </button>
          <button id="tab-btn-2" class="hero-tab-btn px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider bg-slate-100 border-2 border-transparent text-slate-600 hover:text-slate-900 transition-all">
            🌾 Productores & Pymes
          </button>
          <button id="tab-btn-3" class="hero-tab-btn px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider bg-slate-100 border-2 border-transparent text-slate-600 hover:text-slate-900 transition-all">
            🎮 Gaming & 4K
          </button>
        </div>

        <!-- 3D Tilt Card Interactive Container -->
        <div 
          id="hero-tilt-card" 
          class="relative bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-2xl shadow-slate-300/40 text-left transition-transform duration-150 ease-out cursor-pointer overflow-hidden group"
          style="transform-style: preserve-3d;"
        >
          <!-- Subtle lighting reflection overlay -->
          <div id="tilt-glare" class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/40 to-transparent pointer-events-none opacity-0 transition-opacity duration-300"></div>

          <div class="flex flex-col sm:flex-row items-center gap-6 relative z-10">
            <div id="tilt-icon" class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-red-50 border border-red-200 flex items-center justify-center text-3xl sm:text-4xl shadow-xs shrink-0">
              🎓
            </div>
            
            <div class="space-y-1.5 text-center sm:text-left flex-1">
              <div class="flex items-center justify-center sm:justify-start gap-2">
                <span id="tilt-tag" class="text-[11px] font-mono font-bold uppercase text-[#FC0432] bg-red-50 px-2.5 py-0.5 rounded-full border border-red-200">
                  Educación y Streaming
                </span>
                <span class="text-xs text-emerald-600 font-bold font-mono">● Sin Cortes</span>
              </div>
              <h3 id="tilt-title" class="text-xl sm:text-2xl font-black text-slate-900">
                Impulsa la educación de tus hijos con internet estable
              </h3>
              <p id="tilt-desc" class="text-xs sm:text-sm text-slate-500 leading-relaxed font-normal">
                Acceso continuo a plataformas educativas, clases virtuales simultáneas y entretenimiento familiar en alta definición sin interrupciones.
              </p>
            </div>

            <div class="shrink-0 text-center sm:text-right border-t sm:border-t-0 sm:border-l border-slate-100 pt-4 sm:pt-0 sm:pl-6">
              <span class="text-[10px] font-mono text-slate-400 block uppercase">Velocidad Sugerida</span>
              <span id="tilt-speed" class="text-2xl sm:text-3xl font-black font-mono text-[#FC0432] block">50 - 200 <span class="text-xs">MB</span></span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import { animate } from 'animejs';

  // Animaciones iniciales
  animate('.hero-badge, .hero-title, .hero-desc, .hero-cta', {
    opacity: [0, 1],
    translateY: [20, 0],
    delay: (el, i) => i * 120,
    duration: 600,
    ease: 'outQuad'
  });

  // Efecto 3D Tilt interactivo que reacciona a la posición del mouse
  const card = document.getElementById('hero-tilt-card');
  const glare = document.getElementById('tilt-glare');

  if (card) {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      
      const rotateX = ((y - centerY) / centerY) * -8;
      const rotateY = ((x - centerX) / centerX) * 8;

      card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
      
      if (glare) {
        glare.style.opacity = '1';
        glare.style.background = `radial-gradient(circle at ${x}px ${y}px, rgba(255,255,255,0.6) 0%, transparent 60%)`;
      }
    });

    card.addEventListener('mouseleave', () => {
      card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
      if (glare) glare.style.opacity = '0';
    });
  }

  // Lógica de pestañas interactivas de Casos de Uso
  const tabsData = [
    {
      icon: "🎓",
      tag: "Educación & Streaming",
      title: "Impulsa la educación de tus hijos con internet estable",
      desc: "Acceso continuo a plataformas de estudio, videoconferencias escolares y entretenimiento en 4K sin ralentizaciones.",
      speed: "50 - 200 MB"
    },
    {
      icon: "🏢",
      tag: "Productores & Comercios",
      title: "Conectividad robusta para potenciar tu negocio en Trujillo",
      desc: "Enlaces dedicados 1:1, transferencias de archivos masivos, puntos de venta siempre activos y facturación electrónica.",
      speed: "Dedicado SLA"
    },
    {
      icon: "⚡",
      tag: "Gaming & Fibra Simétrica",
      title: "Latencia ultrabaja para juegos competitivos y streaming",
      desc: "Ping mínimo hacia servidores internacionales (<8ms) y velocidad de subida exacta a la de bajada.",
      speed: "200 - 500 MB"
    }
  ];

  const btns = [
    document.getElementById('tab-btn-1'),
    document.getElementById('tab-btn-2'),
    document.getElementById('tab-btn-3')
  ];

  const tiltIcon = document.getElementById('tilt-icon');
  const tiltTag = document.getElementById('tilt-tag');
  const tiltTitle = document.getElementById('tilt-title');
  const tiltDesc = document.getElementById('tilt-desc');
  const tiltSpeed = document.getElementById('tilt-speed');

  btns.forEach((btn, index) => {
    btn?.addEventListener('click', () => {
      btns.forEach(b => {
        if (b) {
          b.className = "hero-tab-btn px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider bg-slate-100 border-2 border-transparent text-slate-600 hover:text-slate-900 transition-all";
        }
      });
      if (btn) {
        btn.className = "hero-tab-btn active px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider bg-white border-2 border-[#FC0432] text-[#FC0432] shadow-sm transition-all";
      }

      const data = tabsData[index];
      if (card) {
        animate(card, {
          scale: [0.98, 1],
          duration: 300,
          ease: 'outQuad'
        });
      }

      if (tiltIcon) tiltIcon.innerText = data.icon;
      if (tiltTag) tiltTag.innerText = data.tag;
      if (tiltTitle) tiltTitle.innerText = data.title;
      if (tiltDesc) tiltDesc.innerText = data.desc;
      if (tiltSpeed) tiltSpeed.innerHTML = `${data.speed} <span class="text-xs">MB</span>`;
    });
  });

  // Canvas interactivo de partículas de fibra flotantes
  const canvas = document.getElementById('hero-particles-canvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    let width = (canvas.width = canvas.offsetWidth);
    let height = (canvas.height = canvas.offsetHeight);

    window.addEventListener('resize', () => {
      width = canvas.width = canvas.offsetWidth;
      height = canvas.height = canvas.offsetHeight;
    });

    const colors = ['rgba(252, 4, 50, ', 'rgba(10, 85, 159, ', 'rgba(0, 150, 255, '];
    
    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
      colorBase: string;
      alpha: number;
    }

    const particleCount = Math.min(50, Math.floor(width / 25));
    const particles: Particle[] = [];

    for (let i = 0; i < particleCount; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.6,
        vy: (Math.random() - 0.5) * 0.6,
        radius: Math.random() * 2.2 + 1,
        colorBase: colors[Math.floor(Math.random() * colors.length)],
        alpha: Math.random() * 0.35 + 0.15
      });
    }

    const mouse = { x: -1000, y: -1000, radius: 120 };

    window.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    });

    function render() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < 100) {
            ctx.beginPath();
            ctx.strokeStyle = `rgba(10, 85, 159, ${0.1 * (1 - dist / 100)})`;
            ctx.lineWidth = 0.8;
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.stroke();
          }
        }
      }

      particles.forEach((p) => {
        p.x += p.vx;
        p.y += p.vy;

        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;

        const dx = mouse.x - p.x;
        const dy = mouse.y - p.y;
        const distance = Math.sqrt(dx * dx + dy * dy);

        if (distance < mouse.radius) {
          const force = (mouse.radius - distance) / mouse.radius;
          const angle = Math.atan2(dy, dx);
          p.x -= Math.cos(angle) * force * 3;
          p.y -= Math.sin(angle) * force * 3;
        }

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fillStyle = `${p.colorBase}${p.alpha})`;
        ctx.fill();
      });

      requestAnimationFrame(render);
    }

    render();
  }
</script>
