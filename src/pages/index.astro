---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import FiberBeam from '../components/FiberBeam.astro';
import Hero from '../components/Hero.astro';
import FiberJourney from '../components/FiberJourney.astro';
import FiberSimulator from '../components/FiberSimulator.astro';
import Plans from '../components/Plans.astro';
import Coverage from '../components/Coverage.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />
  <FiberBeam />
  <main class="relative z-10">
    <Hero />
    <FiberJourney />
    <FiberSimulator />
    <Plans />
    <Coverage />
    <Faq />
  </main>
  <Footer />
</Layout>

<script>
  import { animate } from 'animejs';

  // Sutil animación de entrada para tarjetas y elementos al cruzarse con el scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        animate(entry.target, {
          opacity: [0, 1],
          translateY: [25, 0],
          duration: 700,
          ease: 'outCubic'
        });
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.plan-card, .coverage-card, .faq-item').forEach(el => {
    observer.observe(el);
  });
</script>
