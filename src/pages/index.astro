---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import FiberScrollytelling from '../components/FiberScrollytelling.astro';
import TrustBadges from '../components/TrustBadges.astro';
import CoverageChecker from '../components/CoverageChecker.astro';
import QuickPay from '../components/QuickPay.astro';
import Statement from '../components/Statement.astro';
import AboutUs from '../components/AboutUs.astro';
import PlansCards from '../components/PlansCards.astro';
import PricingTable from '../components/PricingTable.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import OfferBanner from '../components/OfferBanner.astro';
import CoverageMap from '../components/CoverageMap.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <!-- 1. Header institucional + navbar sticky -->
  <Header />

  <main class="relative z-10">
    <!-- 2. Hero con headline, CTAs y mockup visual -->
    <Hero />

    <!-- 2.5. Maqueta 3D Topográfica -->
    <FiberScrollytelling />

    <!-- 3. Validador de Cobertura Prioritario justo bajo el Hero -->
    <div class="-mt-10 mb-8 relative z-30">
      <CoverageChecker id="hero-coverage-checker" />
    </div>

    <!-- 4. Fila de confianza y acreditación institucional (CONATEL, Trujillo, FTTH, Pagos) -->
    <TrustBadges />

    <!-- 5. Portal rápido de autogestión de clientes -->
    <QuickPay />

    <!-- 6. Statement tipográfico de impacto -->
    <Statement />

    <!-- 8. La Empresa / About Us con pilares técnicos -->
    <AboutUs />

    <!-- 9. Servicios y Equipamiento Tangible -->
    <PlansCards />

    <!-- 10. Tabla de Precios y Planes con Garantía de Uptime -->
    <PricingTable />

    <!-- 11. Soluciones Dedicadas y Empresas -->
    <OfferBanner />

    <!-- 12. ¿Por qué elegirnos? Beneficios y Rendimiento -->
    <WhyChooseUs />

    <!-- 13. Zonas de cobertura + Mapa interactivo embebido de Trujillo -->
    <CoverageMap />

    <!-- 14. Testimonios -->
    <Testimonials />

    <!-- 15. Preguntas Frecuentes -->
    <Faq />
  </main>

  <!-- 16. Footer institucional con Speedtest accesible y canales de atención -->
  <Footer />
</Layout>

<script>
  import { animate } from 'animejs';

  // Animación suave de entrada al hacer scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        animate(entry.target, {
          opacity: [0, 1],
          translateY: [25, 0],
          duration: 650,
          ease: 'outCubic'
        });
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.plan-card, .coverage-card, .faq-item, .feature-card').forEach(el => {
    observer.observe(el);
  });
</script>
